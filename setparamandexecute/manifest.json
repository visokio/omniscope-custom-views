{
  "name": "Set Parameters and Execute",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "custom",
    "lambda",
    "parameter",
    "param",
    "workflow",
    "job",
    "execute",
    "execution",
    "block",
    "api"
  ],
  "sandbox": false,
  "autoPane": false,
  "autoQuery": false,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "block": {
        "displayName": "Blocks to execute",
        "type": "TEXT",
        "detail": "Names of the workflow blocks to execute, separated by commas, e.g. Load orders, Report. Leave empty to execute the whole workflow."
      },
      "buttonText": {
        "displayName": "Button text",
        "type": "TEXT",
        "detail": "Text on the button. If empty: Execute"
      },
      "paramNames": {
        "displayName": "Parameters to show",
        "type": "TEXT",
        "detail": "Names of the project parameters to show, in this order, separated by commas. Leave empty to show them all."
      },
      "refreshFromSource": {
        "displayName": "Refresh from source",
        "type": "TOGGLE",
        "detail": "On: the blocks reload their data from the sources. Off: data already loaded upstream is reused where possible.",
        "documentation": "If ticked, Omniscope discards any previous execution data and reloads fresh data from the sources.\n\nIf unticked, Omniscope executes only the blocks that need it, based on their current configuration and previous execution data, and reuses data from upstream blocks where available."
      },
      "showJobState": {
        "displayName": "Show job state",
        "type": "TOGGLE",
        "detail": "Show the execution's progress (queued, running, finished) under the button. Errors are always shown."
      },
      "wGrid": {
        "displayName": "Parameter cell width (px)",
        "type": "NUMBER",
        "detail": "Width of each parameter's label and input (default 200)."
      },
      "wInputWidth": {
        "displayName": "Input width (px)",
        "type": "NUMBER",
        "detail": "Width of each input box (default 100)."
      },
      "zlabelFontSize": {
        "displayName": "Label size (px)",
        "type": "NUMBER",
        "detail": "Font size of the parameter names (default 13)."
      }
    },
    "structure": {
      "toolbar": [
        "block",
        "refreshFromSource",
        "buttonText",
        "paramNames",
        "showJobState"
      ],
      "x": [],
      "y": []
    }
  },
  "defaultOptions": {
    "items": {
      "buttonText": "Execute",
      "refreshFromSource": true,
      "showJobState": true,
      "wGrid": 200,
      "wInputWidth": 100,
      "zlabelFontSize": 13
    },
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "showGridLines": true,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "showPaneXHeader": true,
      "showPaneYHeader": true,
      "showTileHeader": true,
      "xHeaderStyle": {},
      "yHeaderStyle": {},
      "tileHeaderStyle": {},
      "xHeaderLines": 1,
      "tileHeaderLines": 1,
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
