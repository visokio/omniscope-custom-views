[
 {
  "name": "showcase",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Report",
    "paramNames": "Region, Minimum sales",
    "buttonText": "Apply"
   }
  },
  "width": 420,
  "height": 170,
  "wait": 800,
  "showcase": true,
  "showcaseHeight": 170,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Set+Parameters+and+Execute/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Minimum sales",
     "type": "NUMBER",
     "value": 100
    },
    {
     "name": "Report title",
     "type": "TEXT",
     "value": "Orders"
    }
   ],
   "blocks": [
    "Report",
    "Filter orders"
   ]
  },
  "caption": "Live: change the values and press Apply. The parameters and blocks are simulated here; in a report they are the project's own.",
  "expect": {
   "selector": ".param",
   "min": 2,
   "max": 2
  },
  "actions": [
   {
    "expectRequest": {
     "method": "GET",
     "url": "Orders%20demo.iox/w/param/",
     "count": 1
    }
   },
   {
    "eval": "document.getElementById('param-Region').value === 'North' && document.getElementById('param-Minimum_sales').value === '100'",
    "expectTruthy": true
   },
   {
    "eval": "(function () { document.getElementById('param-Region').value = 'South'; document.getElementById('param-Minimum_sales').value = '250'; return true; })()",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Report"
      ],
      "refreshFromSource": true,
      "cancelExisting": false,
      "params": {
       "updates": [
        {
         "name": "Region",
         "value": "South"
        },
        {
         "name": "Minimum sales",
         "value": 250
        }
       ]
      }
     },
     "count": 1
    }
   },
   {
    "wait": 3200
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished at') === 0",
    "expectTruthy": true
   },
   {
    "eval": "window.parent.__omniEvents.every(function (e) { return e.type !== 'whitespaceClick'; })",
    "expectTruthy": true
   },
   {
    "screenshot": "finished"
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Report",
    "paramNames": "Region, Minimum sales"
   }
  },
  "width": 420,
  "height": 170,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Set+Parameters+and+Execute/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Minimum sales",
     "type": "NUMBER",
     "value": 100
    },
    {
     "name": "Report title",
     "type": "TEXT",
     "value": "Orders"
    }
   ],
   "blocks": [
    "Report",
    "Filter orders"
   ]
  },
  "actions": [
   {
    "eval": "(function () { document.getElementById('param-Minimum_sales').value = 'lots'; return true; })()",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "eval": "document.getElementById('status').textContent === 'Enter a number for Minimum sales.'",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 0
    }
   },
   {
    "eval": "(function () { document.getElementById('param-Minimum_sales').value = '1,500'; return true; })()",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "params": {
       "updates": [
        {
         "name": "Region",
         "value": "North"
        },
        {
         "name": "Minimum sales",
         "value": 1500
        }
       ]
      }
     },
     "count": 1
    }
   },
   {
    "wait": 3200
   },
   {
    "clickAt": [
     400,
     160
    ]
   },
   {
    "expectSelection": false
   }
  ]
 },
 {
  "name": "reload-mid-job",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Report",
    "paramNames": "Region, Minimum sales"
   }
  },
  "width": 420,
  "height": 170,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Set+Parameters+and+Execute/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Minimum sales",
     "type": "NUMBER",
     "value": 100
    },
    {
     "name": "Report title",
     "type": "TEXT",
     "value": "Orders"
    }
   ],
   "blocks": [
    "Report",
    "Filter orders"
   ]
  },
  "actions": [
   {
    "eval": "(function () { document.getElementById('param-Region').value = 'South'; document.getElementById('param-Minimum_sales').value = '250'; return true; })()",
    "expectTruthy": true
   },
   {
    "click": "#run",
    "waitAfter": 200
   },
   {
    "reload": true
   },
   {
    "wait": 3200
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished at') === 0 && !document.getElementById('run').disabled",
    "expectTruthy": true
   },
   {
    "eval": "document.getElementById('param-Region').value === 'South'",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 1
    }
   }
  ]
 },
