 {
  "name": "interact",
  "data": "sample-data/us_sales.csv",
  "options": {
   "items": {
    "region": {
     "inputField": "State",
     "type": "UNIQUE_VALUES"
    },
    "value": {
     "inputField": "Sales",
     "function": "SUM"
    },
    "layout": "AUTO",
    "colour": "SEQUENTIAL",
    "showValues": true
   }
  },
  "width": 1000,
  "height": 560,
  "wait": 1200,
  "actions": [
   {
    "eval": "(function(){var M=window.__tile.model;return M.key==='US' && M.n===51 && Math.abs(M.byCode.get('TX').v-7072211.72)<0.01 && M.byCode.get('CA').rank===1 && M.unmatched.length===0})()",
    "expectTruthy": true
   },
   {
    "hover": "g.tile",
    "nth": 4
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "g.tile",
    "nth": 4
   },
   {
    "expectSelection": true
   },
   {
    "eval": "omniscope.view.context().viewSelection.filter.value==='Washington'",
    "expectTruthy": true
   },
   {
    "clickAt": [
     5,
     555
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Month",
     "operator": ">=",
     "value": "2026-10-01"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__tile.model.byCode.get('TX').v<1414442.344",
    "expectTruthy": true
   },
   {
    "resize": [
     420,
     320
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
