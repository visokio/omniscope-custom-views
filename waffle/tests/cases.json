 {
  "name": "interact",
  "data": "sample-data/energy_mix.csv",
  "options": {
   "items": {
    "category": {
     "inputField": "Source",
     "type": "UNIQUE_VALUES"
    },
    "value": {
     "inputField": "Generation (GWh)",
     "function": "SUM"
    },
    "maxParts": 6,
    "grid": "10",
    "shape": "SQUARE"
   }
  },
  "width": 900,
  "height": 480,
  "wait": 1200,
  "actions": [
   {
    "eval": "(function(){var M=window.__waffle.model,P=M.panes[0],i=M.parts.findIndex(function(p){return p.name==='Wind'});return d3.sum(P.sq)===100 && P.sq[i]===Math.round(32.445830163679155) && M.parts[M.parts.length-1].other===true})()",
    "expectTruthy": true
   },
   {
    "hover": ".cell",
    "nth": 5
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": ".cell",
    "nth": 5
   },
   {
    "expectSelection": true
   },
   {
    "eval": "window.__waffle.select({part:window.__waffle.model.parts[5].name})"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "omniscope.view.context().viewSelection.filter.type==='OR'",
    "expectTruthy": true
   },
   {
    "clickAt": [
     5,
     470
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Nation",
     "operator": "=",
     "value": "Scotland"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__waffle.model.total<40000",
    "expectTruthy": true
   },
   {
    "resize": [
     420,
     360
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
