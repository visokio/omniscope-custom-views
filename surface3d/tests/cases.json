 {
  "name": "interact",
  "data": "sample-data/yield_curves.csv",
  "options": {
   "items": {
    "x": {
     "inputField": "Maturity (years)",
     "type": "UNIQUE_VALUES"
    },
    "y": {
     "inputField": "Month",
     "type": "UNIQUE_VALUES"
    },
    "z": {
     "inputField": "Yield %",
     "function": "MEAN"
    },
    "colour": "AUTO",
    "heightScale": 1,
    "wireframe": true,
    "autoRotate": false
   }
  },
  "width": 1000,
  "height": 600,
  "wait": 5000,
  "actions": [
   {
    "eval": "(function(){var M=window.__surf.model;var i=M.X.list.findIndex(function(k){return k.sort===10}),j=M.Y.list.findIndex(function(k){return k.full==='Jan 2024'});return M.nx===12 && M.ny===58 && M.X.kind==='num' && M.Y.kind==='date' && Math.abs(M.grid[i*M.ny+j]-5.14)<1e-9})()",
    "expectTruthy": true
   },
   {
    "hoverEval": "window.__surf.screenOf(6,30)"
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "clickEval": "window.__surf.screenOf(6,30)"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "window.__surf.sel.i===6 && window.__surf.sel.j===30",
    "expectTruthy": true
   },
   {
    "eval": "window.__surf.selectCell(6,30)"
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Month",
     "operator": ">=",
     "value": "2025-01-01"
    }
   },
   {
    "wait": 3000
   },
   {
    "eval": "window.__surf.model.ny===22",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     420
    ]
   },
   {
    "wait": 1500
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
