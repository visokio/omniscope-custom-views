{
  "name": "Ridgeline",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "readme": "README.md",
  "tags": [
    "custom",
    "ridgeline",
    "joyplot",
    "distribution",
    "density",
    "histogram",
    "compare",
    "visokio-agents"
  ],
  "sandbox": false,
  "autoPane": false,
  "autoQuery": false,
  "supportsSelection": true,
  "options": {
    "items": {
      "category": {
        "displayName": "Rows",
        "type": "FIELD",
        "mandatory": true,
        "detail": "One distribution per value of this field, e.g. Hour of day, Carrier, Product or Region"
      },
      "value": {
        "displayName": "Distribution of",
        "type": "FIELD",
        "mandatory": true,
        "validFieldTypes": [
          "NUMBER"
        ],
        "detail": "Numeric field whose distribution is drawn, e.g. Wait seconds, Delivery hours, Price"
      },
      "bins": {
        "displayName": "Detail",
        "type": "NUMBER",
        "minValue": 10,
        "maxValue": 200,
        "detail": "Number of bins across the range before smoothing (default 60)"
      },
      "smooth": {
        "displayName": "Smoothing",
        "type": "NUMBER",
        "minValue": 0,
        "maxValue": 5,
        "detail": "Gaussian smoothing in bins (0 = raw histogram, default 1.5)"
      },
      "overlap": {
        "displayName": "Overlap",
        "type": "NUMBER",
        "minValue": 0.5,
        "maxValue": 4,
        "detail": "How far each ridge rises into the row above (default 1.8)"
      },
      "sort": {
        "displayName": "Order rows by",
        "type": "CHOICE",
        "values": [
          "NATURAL",
          "MEDIAN_DESC",
          "MEDIAN_ASC",
          "COUNT_DESC"
        ],
        "displayValues": [
          "Natural order",
          "Median, highest first",
          "Median, lowest first",
          "Number of records"
        ],
        "detail": "Row order"
      },
      "maxRows": {
        "displayName": "Maximum rows",
        "type": "NUMBER",
        "minValue": 2,
        "maxValue": 60,
        "detail": "Largest number of rows to draw (most records first when limited; default 25)"
      },
      "normalise": {
        "displayName": "Same height for every row",
        "type": "TOGGLE",
        "detail": "Scale each ridge to its own peak, so shapes compare even when counts differ"
      },
      "showMedian": {
        "displayName": "Show medians",
        "type": "TOGGLE",
        "detail": "Mark each row's median and write it at the right"
      },
      "trim": {
        "displayName": "Trim extreme values",
        "type": "TOGGLE",
        "detail": "Set the range from the quartiles (up to three interquartile ranges beyond them) so a few outliers do not squash the chart"
      }
    },
    "structure": {
      "toolbar": [
        "category",
        "value"
      ],
      "x": [],
      "y": []
    },
    "optionGroups": [
      {
        "displayName": "Chart",
        "rows": [
          {
            "cells": [
              {
                "option": "category",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "value",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Shape",
        "rows": [
          {
            "cells": [
              {
                "option": "bins",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "smooth",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "overlap",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "sort",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "maxRows",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "normalise",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "showMedian",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "trim",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {
      "bins": 60,
      "smooth": 1.5,
      "overlap": 1.8,
      "sort": "NATURAL",
      "maxRows": 25,
      "normalise": false,
      "showMedian": true,
      "trim": true
    },
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 100,
      "paneHeight": 100,
      "gridLineThickness": 1,
      "headerStyle": {},
      "tileHeaderAlignment": "CENTER",
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 200,
    "minHeight": 150
  }
}
