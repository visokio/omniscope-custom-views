 {
  "name": "interact",
  "data": "sample-data/calls.csv",
  "options": {
   "items": {
    "category": "Hour",
    "value": "Wait (seconds)",
    "bins": 60,
    "smooth": 1.5,
    "overlap": 1.8,
    "sort": "NATURAL",
    "maxRows": 25,
    "normalise": false,
    "showMedian": true,
    "trim": true
   }
  },
  "width": 1000,
  "height": 540,
  "wait": 2000,
  "actions": [
   {
    "eval": "(function(){var R=window.__ridge.model.rows;var a=R.find(function(r){return r.key==='12:00'}),b=R.find(function(r){return r.key==='08:00'});return R.length===12&&a.med>b.med*2})()",
    "expectTruthy": true
   },
   {
    "hover": "svg rect[fill=transparent]"
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "click": "text.rowlab",
    "nth": 4
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "row"
   },
   {
    "eval": "window.__ridge.selectRange(100,200)"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "range"
   },
   {
    "clickAt": [
     990,
     8
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Day",
     "operator": "=",
     "value": "Mon"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__ridge.model.total<4000",
    "expectTruthy": true
   },
   {
    "resize": [
     540,
     320
    ]
   },
   {
    "screenshot": "small"
   }
  ]
 },
