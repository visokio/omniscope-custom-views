 {
  "name": "interact",
  "data": "sample-data/shipments.csv",
  "options": {
   "items": {
    "origin": {
     "inputField": "Origin port",
     "type": "UNIQUE_VALUES"
    },
    "destination": {
     "inputField": "Destination port",
     "type": "UNIQUE_VALUES"
    },
    "originLat": {
     "inputField": "Origin latitude",
     "function": "MEAN"
    },
    "originLon": {
     "inputField": "Origin longitude",
     "function": "MEAN"
    },
    "destLat": {
     "inputField": "Destination latitude",
     "function": "MEAN"
    },
    "destLon": {
     "inputField": "Destination longitude",
     "function": "MEAN"
    },
    "value": {
     "inputField": "Containers (TEU)",
     "function": "SUM"
    },
    "colourBy": "ORIGIN",
    "maxFlows": 400,
    "animate": true,
    "autoRotate": false,
    "labels": 12,
    "colour": {
     "inputField": "Origin region",
     "type": "UNIQUE_VALUES"
    }
   }
  },
  "width": 900,
  "height": 600,
  "wait": 6000,
  "actions": [
   {
    "eval": "window.__globe.flows.length>50 && window.__globe.places.length===34",
    "expectTruthy": true
   },
   {
    "eval": "window.__globe.selectFlow(0)"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "selected"
   },
   {
    "clickEval": "window.__globe.project(1.26,103.84)"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "place"
   },
   {
    "clickAt": [
     20,
     300
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Destination region",
     "operator": "=",
     "value": "Europe"
    }
   },
   {
    "eval": "window.__globe.flows.every(function(f){return ['Rotterdam','Antwerp','Hamburg','Felixstowe','Southampton','Valencia','Piraeus','Algeciras'].indexOf(f.d.name)>=0})",
    "expectTruthy": true
   },
   {
    "resize": [
     600,
     420
    ]
   },
   {
    "screenshot": "small"
   }
  ],
  "expect": {
   "notBlank": true
  }
 },
