{
  "name": "Beeswarm",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "custom",
    "bee",
    "swarm",
    "circle",
    "dot",
    "jitter"
  ],
  "sandbox": false,
  "autoPane": true,
  "autoQuery": true,
  "dataLimit": 1000,
  "supportsSelection": true,
  "options": {
    "items": {
      "colour": {
        "displayName": "Colour",
        "iconName": "visokio-option-icon:colour-measure",
        "type": "MEASURE",
        "detail": "Colours the dots by category: for example Region with the Singleton function, which gives each dot its one Region"
      },
      "paneX": {
        "displayName": "Pane X",
        "type": "GROUPING",
        "detail": "One chart per value, side by side",
        "list": true
      },
      "paneY": {
        "displayName": "Pane Y",
        "type": "GROUPING",
        "detail": "One chart per value, one above the other",
        "list": true
      },
      "split": {
        "displayName": "Split",
        "type": "GROUPING",
        "mandatory": true,
        "detail": "One dot per value of this grouping, for example per Store"
      },
      "title": {
        "displayName": "Tooltip",
        "type": "MEASURE",
        "detail": "Text shown first in a dot's tooltip, for example a name field with the Singleton function. If empty, the Split value is shown"
      },
      "x": {
        "displayName": "X",
        "type": "MEASURE",
        "detail": "Position along the horizontal axis, for example the sum of Sales growth. If empty, the dots are packed around the centre"
      },
      "y": {
        "displayName": "Y",
        "type": "MEASURE",
        "detail": "Position along the vertical axis. If empty, the dots are packed around the middle line"
      }
    },
    "structure": {
      "toolbar": [
        "colour",
        "split"
      ],
      "x": [
        "x",
        "paneX"
      ],
      "y": [
        "y",
        "paneY"
      ]
    },
    "optionGroups": [{
      "displayName": "Chart",
      "rows": [{
        "cells": [{
          "option": "split",
          "usePrefixTitle": false
        }]
      }, {
        "cells": [{
          "option": "x",
          "usePrefixTitle": false
        }]
      }, {
        "cells": [{
          "option": "y",
          "usePrefixTitle": false
        }]
      }]
    }, {
      "displayName": "Marker",
      "rows": [{
        "cells": [{
          "option": "colour",
          "usePrefixTitle": false
        }]
      }, {
        "cells": [{
          "option": "title",
          "usePrefixTitle": false
        }]
      }]
    }, {
      "displayName": "Pane/tile",
      "rows": [{
        "cells": [{
          "option": "paneX",
          "usePrefixTitle": false
        }]
      }, {
        "cells": [{
          "option": "paneY",
          "usePrefixTitle": false
        }]
      }]
    }]
  },
  "defaultOptions": {
    "items": {},
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "tileHeaderAlignment": "CENTER",
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
