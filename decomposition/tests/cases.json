 {
  "name": "interact",
  "data": "sample-data/sessions.csv",
  "options": {
   "items": {
    "date": "Date",
    "value": {
     "inputField": "Sessions",
     "function": "SUM"
    },
    "period": "WEEK",
    "model": "ADDITIVE",
    "threshold": 3
   }
  },
  "width": 1000,
  "height": 580,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var M=window.__dec.model,a=M.anoms.map(function(p){return p.t});return M.series.length===155 && Math.abs(M.series[100].trend/27411.16346153846-1)<0.03 && a.indexOf(Date.UTC(2025,2,10))>=0 && a.indexOf(Date.UTC(2025,2,17))>=0 && a.indexOf(Date.UTC(2026,8,14))>=0 && M.strength>0.6})()",
    "expectTruthy": true
   },
   {
    "hoverEval": "(function(){var r=document.querySelector('svg > rect').getBoundingClientRect();return [r.left+r.width*0.5, r.top+r.height*0.3]})()"
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "eval": "window.__dec.selectAnomaly(0)"
   },
   {
    "expectSelection": true
   },
   {
    "click": "tr.an",
    "nth": 1
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     5,
     575
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Source",
     "operator": "=",
     "value": "Search"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__dec.model.series[100].trend<0.6*27411.16346153846",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     460
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
