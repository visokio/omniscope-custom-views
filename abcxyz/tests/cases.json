 {
  "name": "interact",
  "data": "sample-data/sku_demand.csv",
  "options": {
   "items": {
    "item": "SKU",
    "date": "Month",
    "demand": "Units",
    "value": "Revenue",
    "period": "MONTH",
    "aShare": 80,
    "bShare": 95,
    "xCV": 0.5,
    "yCV": 1.0
   }
  },
  "width": 1000,
  "height": 500,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var c=window.__abc.model.cells,ref={\"AX\": 103, \"AZ\": 105, \"AY\": 13, \"BX\": 231, \"BZ\": 121, \"BY\": 33, \"CZ\": 138, \"CY\": 26, \"CX\": 430};return Object.keys(ref).every(function(k){return c[k].n===ref[k]}) && window.__abc.model.np===24})()",
    "expectTruthy": true
   },
   {
    "hover": "g.cell",
    "nth": 2
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "g.cell",
    "nth": 2
   },
   {
    "expectSelection": true
   },
   {
    "eval": "omniscope.view.context().viewSelection.filter.filters.length===105",
    "expectTruthy": true
   },
   {
    "clickAt": [
     8,
     495
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Category",
     "operator": "=",
     "value": "Fasteners"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__abc.model.list.length<400",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     440
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
