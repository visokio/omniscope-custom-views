 {
  "name": "interact",
  "data": "sample-data/baskets.csv",
  "options": {
   "items": {
    "basket": "Basket ID",
    "item": "Product",
    "rank": "LIFT",
    "order": "CLUSTER",
    "topItems": 35,
    "minSupport": 0.5,
    "maxLines": 300000,
    "group": "Department"
   }
  },
  "width": 1000,
  "height": 640,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var M=window.__basket.model;return M.nb===6000 && window.__basket.liftOf('Pasta','Pasta sauce')>4 && window.__basket.liftOf('Nappies','Baby wipes')>8 && Math.abs(window.__basket.liftOf('Milk','Bread')-1)<0.3 && M.groups.length===7})()",
    "expectTruthy": true
   },
   {
    "eval": "(function(){var o=window.__basket.model.order;var a=o.indexOf(window.__basket.model.items.find(function(I){return I.name==='Pasta'}).k),b=o.indexOf(window.__basket.model.items.find(function(I){return I.name==='Pasta sauce'}).k);return Math.abs(a-b)<=2})()",
    "expectTruthy": true
   },
   {
    "eval": "window.__basket.selectPair('Pasta','Pasta sauce')"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "pair"
   },
   {
    "hover": "rect.cell",
    "nth": 40
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "click": "text.lab",
    "nth": 2
   },
   {
    "expectSelection": true
   },
   {
    "eval": "window.__basket.focus!==null && document.querySelectorAll('.rule').length>0",
    "expectTruthy": true
   },
   {
    "screenshot": "focus"
   },
   {
    "clickAt": [
     20,
     620
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Store",
     "operator": "=",
     "value": "Station"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__basket.model.nb<1600",
    "expectTruthy": true
   },
   {
    "resize": [
     600,
     460
    ]
   },
   {
    "screenshot": "narrow"
   }
