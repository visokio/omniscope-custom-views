 {
  "name": "interact",
  "data": "sample-data/deliveries.csv",
  "options": {
   "items": {
    "x": "Distance (km)",
    "y": "Delivery time (minutes)",
    "bins": 80,
    "logScale": true,
    "trim": true,
    "marginals": true,
    "minCount": 1
   }
  },
  "width": 1000,
  "height": 560,
  "wait": 2000,
  "actions": [
   {
    "eval": "(function(){var M=window.__density.model;return M.total===40000 && M.cells.length>200})()",
    "expectTruthy": true
   },
   {
    "hover": "svg .overlay"
   },
   {
    "eval": "window.__density.selectBox(5,15,30,60)"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "box"
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Fleet",
     "operator": "=",
     "value": "E-bike"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__density.model.total<25000",
    "expectTruthy": true
   },
   {
    "resize": [
     520,
     360
    ]
   },
   {
    "screenshot": "small"
   }
  ]
 },
