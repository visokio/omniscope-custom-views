{
  "name": "Custom HTML",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "HTML",
    "web",
    "widget",
    "content"
  ],
  "sandbox": false,
  "autoPane": true,
  "autoQuery": true,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "aStaticHTML": {
        "displayName": "Static HTML",
        "documentation": "HTML shown in the view, for example an embedded widget. Used when Show HTML from the data is off. Script tags in it do not run",
        "type": "TEXT"
      },
      "dynamicHTML": {
        "displayName": "Show HTML from the data",
        "documentation": "When on, the view shows the HTML value from the data instead of Static HTML, and follows the report's filters and selections",
        "type": "TOGGLE"
      },
      "measures": {
        "displayName": "HTML value",
        "type": "MEASURE",
        "detail": "The field holding HTML, with a function that gives one value: Singleton (empty unless all records agree), Mode, Min or Max"
      },
      "msplit": {
        "displayName": "One block per",
        "type": "GROUPING",
        "detail": "Optional: one block of HTML per value of this field, one under the other"
      },
      "paneX": {
        "displayName": "Pane X",
        "type": "GROUPING",
        "list": true,
        "detail": "Optional: one view per value, side by side"
      },
      "paneY": {
        "displayName": "Pane Y",
        "type": "GROUPING",
        "list": true,
        "detail": "Optional: one view per value, one above the other"
      }
    },
    "structure": {
      "toolbar": [
        "measures",
        "msplit"
      ],
      "x": [
        "paneX"
      ],
      "y": [
        "paneY"
      ]
    },
    "optionGroups": [
      {
        "displayName": "Content",
        "rows": [
          {
            "cells": [
              {
                "option": "aStaticHTML",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "dynamicHTML",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "HTML from the data",
        "rows": [
          {
            "cells": [
              {
                "option": "measures",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "msplit",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Panes",
        "rows": [
          {
            "cells": [
              {
                "option": "paneX",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "paneY",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {},
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "showGridLines": true,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "xHeaderStyle": {},
      "yHeaderStyle": {},
      "tileHeaderStyle": {},
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
