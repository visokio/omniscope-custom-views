[
 {
  "name": "showcase",
  "showcase": true,
  "data": "sample-data/customers.csv",
  "options": {
   "items": {
    "filterAField": "Orders (12 months)",
    "filterAMin": "10",
    "setAName": "Frequent buyers",
    "filterBField": "Average basket",
    "filterBMin": "80",
    "setBName": "Big baskets",
    "filterCField": "Days since last order",
    "filterCMax": "30",
    "setCName": "Recently active"
   }
  },
  "width": 640,
  "height": 520,
  "showcaseHeight": 520,
  "wait": 1200,
  "caption": "Live: 600 invented customers in three sets: more than 10 orders, an average basket above 80, and an order in the last 30 days. Click a region to select exactly the customers in it; hover for its share.",
  "actions": [
   {
    "eval": "(function(){var c=window.__venn.counts;return !!c&&c.a===55&&c.b===44&&c.c===106&&c.ab===20&&c.bc===32&&c.ac===84&&c.abc===16&&window.__venn.outside===243&&window.__venn.total===600})()",
    "expectTruthy": true
   },
   {
    "eval": "document.getElementById('text-a').textContent==='Frequent buyers'",
    "expectTruthy": true
   },
   {
    "eval": "bound('1,000')===1000 && bound(' 0.5 ')===0.5 && bound('')===null && bound('abc')===null",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/customers.csv",
  "options": {
   "items": {
    "filterAField": "Orders (12 months)",
    "filterAMin": "10",
    "setAName": "Frequent buyers",
    "filterBField": "Average basket",
    "filterBMin": "80",
    "setBName": "Big baskets",
    "filterCField": "Days since last order",
    "filterCMax": "30",
    "setCName": "Recently active"
   }
  },
  "width": 640,
  "height": 520,
  "wait": 1200,
  "actions": [
   {
    "click": "#subset-ac"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "(function(){var f=omniscope.view.context().viewSelection.filter;return f.type==='AND'&&f.filters.length===3&&f.filters.filter(function(x){return x.type==='NOT'}).length===1&&f.filters[1].type==='NOT'})()",
    "expectTruthy": true
   },
   {
    "eval": "document.querySelector('#subset-ac').classList.contains('selected')",
    "expectTruthy": true
   },
   {
    "screenshot": "selected"
   },
   {
    "click": "#subset-ac"
   },
   {
    "expectSelection": false
   },
   {
    "click": "#subset-a"
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     4,
     4
    ]
   },
   {
    "expectSelection": false
   },
   {
    "eval": "document.querySelectorAll('.region.selected').length===0",
    "expectTruthy": true
   },
   {
    "hover": "#subset-b"
   },
   {
    "eval": "document.querySelector('#subset-b title').textContent==='Big baskets, not Frequent buyers or Recently active: 44 records (7.3%)'",
    "expectTruthy": true
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "North"
    }
   },
   {
    "eval": "(function(){var c=window.__venn.counts;return !!c&&c.a===14&&c.b===12&&c.c===26&&c.ab===7&&c.bc===6&&c.ac===22&&c.abc===5&&window.__venn.outside===57})()",
    "expectTruthy": true
   },
   {
    "screenshot": "filtered"
   }
  ]
 },
