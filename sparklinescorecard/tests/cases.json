 {
  "name": "interact",
  "data": "sample-data/stores.csv",
  "options": {
   "items": {
    "rows": {
     "inputField": "Store",
     "type": "UNIQUE_VALUES"
    },
    "time": {
     "inputField": "Week",
     "type": "UNIQUE_VALUES"
    },
    "value": {
     "inputField": "Sales (GBP)",
     "function": "SUM"
    },
    "target": {
     "inputField": "Target (GBP)",
     "function": "SUM"
    },
    "direction": "HIGHER",
    "headline": "LAST",
    "compare": "PREVIOUS",
    "periods": 13,
    "tolerance": 5,
    "sortBy": "ATTAINMENT_ASC"
   }
  },
  "width": 1000,
  "height": 600,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var R=window.__score.model.rows;return R.length===16 && R.some(function(o){return o.status==='bad'}) && R.some(function(o){return o.status==='good'}) && window.__score.model.periods.length===13})()",
    "expectTruthy": true
   },
   {
    "hover": "td.spark svg",
    "nth": 2
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "tr.r",
    "nth": 0
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "selected"
   },
   {
    "eval": "window.__score.select(window.__score.model.rows[3].key, 5)"
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     990,
     595
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "London"
    }
   },
   {
    "eval": "window.__score.model.rows.length===4",
    "expectTruthy": true
   },
   {
    "resize": [
     520,
     400
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
