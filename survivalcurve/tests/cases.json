 {
  "name": "interact",
  "data": "sample-data/subscriptions.csv",
  "options": {
   "items": {
    "start": "Start date",
    "end": "End date",
    "group": "Plan",
    "unit": "AUTO",
    "show": "SURVIVAL",
    "bands": true
   }
  },
  "width": 1000,
  "height": 600,
  "wait": 1500,
  "actions": [
   {
    "eval": "Math.abs(window.__surv.at('Monthly',6)-0.46)<0.0005 && Math.abs(window.__surv.at('Annual',13)-0.6293)<0.0005 && Math.abs(window.__surv.at('Family',6)-0.749)<0.0005 && window.__surv.model.unit==='months'",
    "expectTruthy": true
   },
   {
    "eval": "window.__surv.model.test.df===2 && window.__surv.model.test.p<0.001",
    "expectTruthy": true
   },
   {
    "hoverEval": "(function(){var r=document.querySelector('rect.plot').getBoundingClientRect();return [r.left+r.width*0.3, r.top+r.height*0.42]})()"
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block' && document.getElementById('tooltip').textContent.indexOf('Monthly')>=0",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "eval": "window.__surv.selectGroup('Annual')"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "selected"
   },
   {
    "clickAt": [
     8,
     590
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "Wales"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__surv.model.n<1000",
    "expectTruthy": true
   },
   {
    "resize": [
     600,
     420
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
