[
 {
  "name": "showcase",
  "showcase": true,
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "measure": {
     "inputField": "Sales",
     "function": "SUM"
    },
    "text": "Total sales"
   }
  },
  "width": 420,
  "height": 220,
  "showcaseHeight": 220,
  "wait": 1000,
  "caption": "Live: total sales over 400 invented orders, with a title set in Title text.",
  "expect": {
   "text": "Total sales"
  },
  "actions": [
   {
    "eval": "document.getElementById('measure').textContent==='140,138'",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "average",
  "showcase": true,
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "measure": {
     "inputField": "Discount (%)",
     "function": "MEAN"
    }
   }
  },
  "width": 420,
  "height": 220,
  "showcaseHeight": 220,
  "wait": 1000,
  "caption": "Live: the mean discount, with Title text left empty so the measure's name is the title. Values below 100 keep their decimals.",
  "expect": {
   "text": "Discount (%) (mean)"
  },
  "actions": [
   {
    "eval": "document.getElementById('measure').textContent==='3.69'",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "count",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "measure": {
     "function": "RECORD_COUNT"
    }
   }
  },
  "width": 420,
  "height": 220,
  "wait": 1000,
  "expect": {
   "text": "Record count"
  },
  "actions": [
   {
    "eval": "document.getElementById('measure').textContent==='400'",
    "expectTruthy": true
   },
   {
    "eval": "format(0.034217)==='0.0342' && format(-2.5)==='-2.5' && format(1234567.4)==='1,234,567'",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "measure": {
     "inputField": "Sales",
     "function": "SUM"
    },
    "text": "Total sales"
   }
  },
  "width": 420,
  "height": 220,
  "wait": 1000,
  "actions": [
   {
    "clickAt": [
     10,
     10
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "North"
    }
   },
   {
    "eval": "document.getElementById('measure').textContent==='31,636'",
    "expectTruthy": true
   },
   {
    "screenshot": "filtered"
   },
   {
    "update": {
     "measure": {
      "inputField": "Units",
      "function": "SUM"
     },
     "text": "Units sold"
    }
   },
   {
    "eval": "document.getElementById('text').textContent==='Units sold' && /^[0-9,]+$/.test(document.getElementById('measure').textContent)",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "small",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "measure": {
     "inputField": "Sales",
     "function": "SUM"
    },
    "text": "Total sales"
   }
  },
  "width": 900,
  "height": 500,
  "wait": 1000,
  "actions": [
   {
    "eval": "parseFloat(document.getElementById('measure').style.fontSize) >= 60",
    "expectTruthy": true
   },
   {
    "resize": [
     140,
     70
    ]
   },
   {
    "eval": "document.getElementById('measure').getBoundingClientRect().width <= window.innerWidth && document.getElementById('measure').getBoundingClientRect().height <= window.innerHeight",
    "expectTruthy": true
   },
   {
    "screenshot": "140x70"
   }
  ],
  "expect": {
   "text": "Total sales"
  }
 },
 {
  "name": "empty",
  "fields": [
