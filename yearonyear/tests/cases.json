 {
  "name": "interact",
  "data": "sample-data/orders_daily.csv",
  "options": {
   "items": {
    "date": "Date",
    "value": {
     "inputField": "Orders",
     "function": "SUM"
    },
    "period": "MONTH",
    "mode": "PERIOD",
    "years": 3,
    "fiscalStart": 1
   }
  },
  "width": 1000,
  "height": 500,
  "wait": 1500,
  "actions": [
   {
    "eval": "window.__yoy.model.ytdC===149561 && window.__yoy.model.ytdP===136494 && window.__yoy.model.lfl.length===10 && !window.__yoy.model.partialLast",
    "expectTruthy": true
   },
   {
    "hoverEval": "(function(){var r=document.querySelector('svg g rect').getBoundingClientRect();return [r.left+r.width*0.45, r.top+r.height*0.5]})()"
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "circle.pt",
    "nth": 3
   },
   {
    "expectSelection": true
   },
   {
    "eval": "window.__yoy.selectYear(1)"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "(function(){var f=omniscope.view.context().viewSelection.filter;return f.filters[0].value==='2025-01-01' && f.filters[1].value==='2026-01-01'})()",
    "expectTruthy": true
   },
   {
    "clickAt": [
     8,
     495
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Channel",
     "operator": "=",
     "value": "Online"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__yoy.model.ytdC<100000",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     420
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
