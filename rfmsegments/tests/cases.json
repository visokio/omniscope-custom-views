  }
 },
 {
  "name": "interact",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "customer": "Customer ID",
    "date": "Order date",
    "value": "Order value",
    "orders": "Order ID",
    "maxCustomers": 200000
   }
  },
  "width": 1000,
  "height": 620,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var s=window.__rfm.model.segs,ref={\"0\": 732, \"1\": 264, \"2\": 370, \"3\": 53, \"4\": 70, \"5\": 122, \"6\": 199, \"7\": 466, \"8\": 123, \"9\": 257, \"10\": 344};return Object.keys(ref).every(function(k){return s[+k].n===ref[k]}) && window.__rfm.model.n===3000})()",
    "expectTruthy": true
   },
   {
    "hover": "rect.cell",
    "nth": 12
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "eval": "window.__rfm.selectSeg('At risk')"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "atrisk"
   },
   {
    "click": "rect.cell",
    "nth": 24
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     10,
     600
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "Scotland"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__rfm.model.n<500",
    "expectTruthy": true
   },
   {
    "resize": [
     600,
     460
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
