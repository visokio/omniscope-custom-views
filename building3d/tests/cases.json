 {
  "name": "interact",
  "data": "sample-data/office.csv",
  "options": {
   "items": {
    "floor": {
     "inputField": "Floor",
     "type": "UNIQUE_VALUES"
    },
    "zone": {
     "inputField": "Zone",
     "type": "UNIQUE_VALUES"
    },
    "x": {
     "inputField": "X (m)",
     "function": "MIN"
    },
    "y": {
     "inputField": "Y (m)",
     "function": "MIN"
    },
    "w": {
     "inputField": "Width (m)",
     "function": "MIN"
    },
    "d": {
     "inputField": "Depth (m)",
     "function": "MIN"
    },
    "value": {
     "inputField": "Occupancy (%)",
     "function": "MEAN"
    },
    "scale": "SEQUENTIAL",
    "floorHeight": 3.5,
    "explode": 3,
    "labels": true,
    "theme": "LIGHT"
   }
  },
  "width": 900,
  "height": 600,
  "wait": 4000,
  "actions": [
   {
    "eval": "window.__bldg.zones.length===34 && window.__bldg.fkeys.length===5",
    "expectTruthy": true
   },
   {
    "clickEval": "window.__bldg.project(window.__bldg.zones.findIndex(function(z){return z.f===3&&z.z==='Open plan east'}))"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "selected"
   },
   {
    "hoverEval": "window.__bldg.project(10)"
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "click": "#floors button[data-f='4']"
   },
   {
    "eval": "window.__bldg.zones.filter(function(z){return z.mesh.visible}).length===7",
    "expectTruthy": true
   },
   {
    "screenshot": "isolated"
   },
   {
    "click": "#floors button[data-f='']"
   },
   {
    "clickAt": [
     893,
     595
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Hour",
     "operator": ">=",
     "value": 15
    }
   },
   {
    "eval": "window.__bldg.zones.length===34",
    "expectTruthy": true
   },
   {
    "resize": [
     600,
     420
    ]
   },
   {
    "screenshot": "small"
   }
  ],
  "expect": {
   "notBlank": true
  }
 },
