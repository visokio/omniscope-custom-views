{
  "name": "Bubble Chart",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "custom",
    "bubble",
    "packed",
    "circles",
    "proportion"
  ],
  "sandbox": false,
  "autoPane": true,
  "autoQuery": true,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "split": {
        "displayName": "One bubble per",
        "type": "GROUPING",
        "mandatory": true,
        "validGroupingTypes": [
          "UNIQUE_VALUES"
        ],
        "detail": "One bubble for each value of this field, for example Product"
      },
      "measures": {
        "displayName": "Size",
        "type": "MEASURE",
        "iconName": "visokio-option-icon:size-measure",
        "mandatory": true,
        "validMeasureResultTypes": [
          "NUMBER"
        ],
        "detail": "The bubble's area is proportional to this measure, for example the sum of Revenue. Zero, negative and empty values are not drawn"
      },
      "colour": {
        "displayName": "Group and colour by",
        "type": "GROUPING",
        "validGroupingTypes": [
          "UNIQUE_VALUES"
        ],
        "detail": "Optional. Packs the bubbles into one circle per value of this field, for example Category, and colours them by it. If empty, each bubble is coloured by its own name"
      },
      "labels": {
        "displayName": "Labels",
        "type": "CHOICE",
        "values": [
          "NAME_VALUE",
          "NAME",
          "NONE"
        ],
        "displayValues": [
          "Name and value",
          "Name",
          "None"
        ],
        "detail": "What to write inside bubbles big enough to hold it"
      },
      "paneX": {
        "displayName": "Pane X",
        "type": "GROUPING",
        "list": true,
        "detail": "Optional. One chart per value, side by side"
      },
      "paneY": {
        "displayName": "Pane Y",
        "type": "GROUPING",
        "list": true,
        "detail": "Optional. One chart per value, one above the other"
      }
    },
    "structure": {
      "toolbar": [
        "measures",
        "split",
        "colour"
      ],
      "x": [
        "paneX"
      ],
      "y": [
        "paneY"
      ]
    },
    "optionGroups": [
      {
        "displayName": "Bubbles",
        "rows": [
          {
            "cells": [
              {
                "option": "split",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "measures",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "colour",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "labels",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Pane/tile",
        "rows": [
          {
            "cells": [
              {
                "option": "paneX",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "paneY",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {
      "labels": "NAME_VALUE"
    },
    "pane": {
      "yAxisHeaderWidth": 50,
      "paneWidth": 200,
      "paneHeight": 200,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "tileHeaderAlignment": "CENTER",
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
