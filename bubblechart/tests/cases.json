[
 {
  "name": "showcase",
  "showcase": true,
  "data": "sample-data/sales.csv",
  "options": {
   "items": {
    "split": {
     "inputField": "Product",
     "type": "UNIQUE_VALUES"
    },
    "measures": {
     "inputField": "Revenue",
     "function": "SUM"
    }
   }
  },
  "width": 900,
  "height": 520,
  "showcaseHeight": 520,
  "wait": 1800,
  "caption": "Live: revenue by product for an invented outdoor equipment shop, one bubble per product with its area in proportion to revenue. Hover a bubble for its figures; click it to select the product.",
  "expect": {
   "selector": ".bubble circle",
   "min": 28,
   "max": 28
  },
  "actions": [
   {
    "eval": "(function(){var b=(function(){var t=null;document.querySelectorAll('.bubble').forEach(function(b){if(b.__data__.data.name==='Tunnel 6 tent')t=b});return t})();return b.querySelector('title').textContent.indexOf('Revenue (sum): 21,086')>0 && b.__data__.r===Math.max.apply(null,[].map.call(document.querySelectorAll('.bubble'),function(x){return x.__data__.r}))})()",
    "expectTruthy": true
   },
   {
    "eval": "document.querySelectorAll('.bubble text.value').length>=10 && document.getElementById('note').textContent===''",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "grouped",
  "showcase": true,
  "data": "sample-data/sales.csv",
  "options": {
   "items": {
    "split": {
     "inputField": "Product",
     "type": "UNIQUE_VALUES"
    },
    "measures": {
     "inputField": "Revenue",
     "function": "SUM"
    },
    "colour": {
     "inputField": "Category",
     "type": "UNIQUE_VALUES"
    }
   }
  },
  "width": 900,
  "height": 560,
  "showcaseHeight": 560,
  "wait": 1800,
  "caption": "Live: the same products packed by category with Group and colour by. Tents bring in the most revenue from the fewest products.",
  "expect": {
   "selector": ".bubble circle",
   "min": 28,
   "max": 28
  },
  "actions": [
   {
    "eval": "document.querySelectorAll('.group').length===6 && [].some.call(document.querySelectorAll('.group-labels text'),function(t){return t.textContent==='Tents'})",
    "expectTruthy": true
   },
   {
    "eval": "(function(){var g=null;document.querySelectorAll('.group').forEach(function(x){if(x.__data__.data.group==='Tents')g=x});return g.querySelector('title').textContent.indexOf('40,026')>0})()",
    "expectTruthy": true
   },
   {
    "eval": "(function(){var f={};document.querySelectorAll('.bubble').forEach(function(b){var d=b.__data__.data;(f[d.group]=f[d.group]||{})[b.querySelector('circle').getAttribute('fill')]=1});return Object.keys(f).every(function(k){return Object.keys(f[k]).length===1})})()",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/sales.csv",
  "options": {
   "items": {
    "split": {
     "inputField": "Product",
     "type": "UNIQUE_VALUES"
    },
    "measures": {
     "inputField": "Revenue",
     "function": "SUM"
    },
    "colour": {
     "inputField": "Category",
     "type": "UNIQUE_VALUES"
    }
   }
  },
  "width": 900,
  "height": 520,
  "wait": 1800,
  "actions": [
   {
    "eval": "(function(){window.__fill=(function(){var t=null;document.querySelectorAll('.bubble').forEach(function(b){if(b.__data__.data.name==='Tunnel 6 tent')t=b});return t})().querySelector('circle').getAttribute('fill');return !!window.__fill})()",
    "expectTruthy": true
   },
   {
    "hover": ".bubble",
    "nth": 0
   },
   {
    "click": ".bubble",
    "nth": 0
   },
   {
    "expectSelection": true
   },
   {
    "eval": "(function(){var f=omniscope.view.context().viewSelection.filter;return f.type==='AND'&&f.filters[0].inputField==='Product'&&f.filters[1].inputField==='Category'&&document.querySelectorAll('.bubble.selected').length===1})()",
    "expectTruthy": true
   },
   {
    "screenshot": "selected"
   },
   {
    "click": ".bubble.selected"
   },
   {
    "expectSelection": false
   },
   {
    "eval": "(function(){var g=d3.select('.group');g.dispatch('click');return document.querySelectorAll('.group.selected').length===1})()",
    "expectTruthy": true
   },
   {
    "expectSelection": true
   },
   {
    "eval": "omniscope.view.context().viewSelection.filter.inputField==='Category'",
    "expectTruthy": true
   },
   {
    "clickAt": [
     4,
     4
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Category",
     "operator": "=",
     "value": "Tents"
    }
   },
   {
    "eval": "document.querySelectorAll('.bubble').length===4 && (function(){var t=null;document.querySelectorAll('.bubble').forEach(function(b){if(b.__data__.data.name==='Tunnel 6 tent')t=b});return t})().querySelector('circle').getAttribute('fill')===window.__fill",
    "expectTruthy": true
   },
   {
    "screenshot": "filtered"
   },
   {
    "update": {
     "split": {
      "inputField": "Product",
      "type": "UNIQUE_VALUES"
     },
     "measures": {
      "inputField": "Units",
      "function": "SUM"
     },
     "colour": null,
     "labels": "NAME"
    }
   },
   {
    "eval": "document.querySelectorAll('.group').length===0 && document.querySelectorAll('.bubble text.value').length===0 && document.querySelectorAll('.bubble text.name').length>0 && document.querySelector('.bubble title').textContent.indexOf('Units (sum): ')>0",
    "expectTruthy": true
   }
  ]
 },
