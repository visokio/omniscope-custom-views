{
  "name": "JSON Tree",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "tags": [
    "custom",
    "tree",
    "json"
  ],
  "sandbox": false,
  "autoPane": true,
  "autoQuery": false,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "json": {
        "displayName": "JSON field",
        "detail": "A text field whose values are JSON. Each record is one node of the tree",
        "type": "FIELD",
        "validFieldTypes": [
          "TEXT"
        ]
      },
      "label": {
        "displayName": "Record label",
        "detail": "Optional: a field that names each record's node, for example an ID. Clicking a record's node then selects the records with that label",
        "type": "FIELD"
      }
    },
    "structure": {
      "toolbar": [
        "json",
        "label"
      ],
      "x": [],
      "y": []
    },
    "optionGroups": [
      {
        "displayName": "Data",
        "rows": [
          {
            "cells": [
              {
                "option": "json",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "label",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {},
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "showGridLines": true,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "showPaneXHeader": true,
      "showPaneYHeader": true,
      "showTileHeader": true,
      "xHeaderStyle": {},
      "yHeaderStyle": {},
      "tileHeaderStyle": {},
      "xHeaderLines": 1,
      "tileHeaderLines": 1,
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
