    "base": "",
    "current": "",
    "volume": "Units",
    "revenue": "Revenue (GBP)",
    "topN": 12
   }
  },
  "width": 600,
  "height": 300,
  "wait": 1500,
  "expect": {
   "text": "two periods"
  }
 },
 {
