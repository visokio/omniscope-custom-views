  "expect": {
   "selector": "tr.g",
   "min": 6
  }
 },
 {
  "name": "interact",
  "data": "sample-data/employees.csv",
  "options": {
   "items": {
    "group": "Gender",
    "pay": "Hourly pay",
    "bonus": "Bonus paid",
    "breakdown": "Department"
   }
  },
  "width": 1000,
  "height": 620,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var M=window.__gap.model;return M.ref==='Male' && M.cmp==='Female' && Math.abs(M.G.mean-0.15133563663609903)<1e-9 && Math.abs(M.G.median-0.15534254299407946)<1e-9 && Math.abs(M.G.bmedian-0.3432890270596072)<1e-9 && Math.abs(M.C.bshare-0.6265356265356266)<1e-9 && Math.abs(M.qs[3].cmp/M.qs[3].n-0.3691275167785235)<1e-9 && M.excluded===12})()",
    "expectTruthy": true
   },
   {
    "hover": ".seg",
    "nth": 1
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": ".seg",
    "nth": 1
   },
   {
    "expectSelection": true
   },
   {
    "click": "tr.g",
    "nth": 0
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     990,
     8
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Working pattern",
     "operator": "=",
     "value": "Full-time"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__gap.model.rows.length<1600",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     620
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
