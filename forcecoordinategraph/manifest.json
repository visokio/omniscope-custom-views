{
  "name": "Force Coordinate Graph",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "custom",
    "circle",
    "dot",
    "jitter",
    "coordinate",
    "graph",
    "diagram",
    "edge",
    "bundle",
    "force",
    "network",
    "structure"
  ],
  "sandbox": false,
  "autoPane": true,
  "autoQuery": true,
  "dataLimit": 100000,
  "supportsSelection": true,
  "options": {
    "items": {
      "preventNodeOverlap": {
        "displayName": "Keep nodes apart",
        "type": "TOGGLE",
        "detail": "Push nodes that would overlap a little away from their coordinates, so none hides another"
      },
      "colour": {
        "displayName": "Colour",
        "iconName": "visokio-option-icon:colour-measure",
        "type": "MEASURE",
        "detail": "Colours the nodes and their outgoing links: a text field with the Singleton function (for example Region) gives category colours with a key; a number gives a colour scale"
      },
      "edgeWeight": {
        "displayName": "Link weight",
        "detail": "Thicker lines for heavier links, for example the sum of Shipments. When there are more links than Links shown, the heaviest are kept",
        "type": "MEASURE"
      },
      "imageURL": {
        "displayName": "Image URL",
        "type": "MEASURE",
        "detail": "Address of a picture drawn inside the node (a text field with the Singleton function). The browser showing the report must be able to load it"
      },
      "linkedNodeId": {
        "displayName": "To node",
        "detail": "The node at the other end of the record's link, a value of the From node field. Leave it empty for a record that only places a node",
        "type": "GROUPING",
        "mandatory": true
      },
      "markerSize": {
        "displayName": "Size",
        "iconName": "visokio-option-icon:size-measure",
        "type": "MEASURE",
        "detail": "Sizes the nodes by area, for example the mean of Capacity. Empty: all nodes the same size"
      },
      "nodeId": {
        "displayName": "From node",
        "detail": "One node per value. Each record is a link from this node to To node; give every node at least one record, with To node empty if it has no links",
        "type": "GROUPING",
        "mandatory": true
      },
      "paneX": {
        "displayName": "Pane X",
        "type": "GROUPING",
        "list": true,
        "detail": "One graph per value, side by side"
      },
      "paneY": {
        "displayName": "Pane Y",
        "type": "GROUPING",
        "list": true,
        "detail": "One graph per value, one above the other"
      },
      "title": {
        "displayName": "Tooltip",
        "type": "MEASURE",
        "detail": "First line of a node's tooltip, for example a name field with the Singleton function. Empty: the From node value"
      },
      "x": {
        "displayName": "X position",
        "type": "MEASURE",
        "mandatory": true,
        "detail": "The node's horizontal coordinate, for example the mean of East (km). Worked out in advance: the view keeps nodes near these coordinates"
      },
      "y": {
        "displayName": "Y position",
        "type": "MEASURE",
        "mandatory": true,
        "detail": "The node's vertical coordinate, for example the mean of North (km)"
      },
      "bundleEdges": {
        "displayName": "Bundle links",
        "type": "TOGGLE",
        "detail": "Curve links that run in the same direction into shared bundles, so the main flows stand out. Off: straight lines"
      },
      "maxEdges": {
        "displayName": "Links shown",
        "type": "NUMBER",
        "detail": "The most links drawn (default 1000, at most 5000). Bundling many links takes a few seconds"
      }
    },
    "structure": {
      "toolbar": [
        "colour",
        "markerSize"
      ],
      "x": [
        "x",
        "paneX"
      ],
      "y": [
        "y",
        "paneY"
      ]
    },
    "optionGroups": [
      {
        "displayName": "Chart",
        "rows": [
          {
            "cells": [
              {
                "option": "nodeId",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "linkedNodeId",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "x",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "y",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "preventNodeOverlap",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Marker",
        "rows": [
          {
            "cells": [
              {
                "option": "colour",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "markerSize",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "title",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "imageURL",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Links",
        "rows": [
          {
            "cells": [
              {
                "option": "edgeWeight",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "bundleEdges",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "maxEdges",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Pane/tile",
        "rows": [
          {
            "cells": [
              {
                "option": "paneX",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "paneY",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {
      "preventNodeOverlap": true,
      "bundleEdges": true,
      "maxEdges": 1000
    },
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "tileHeaderAlignment": "CENTER",
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
