    "expectTruthy": true
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/routes.csv",
  "options": {
   "items": {
    "nodeId": {
     "inputField": "Depot",
     "type": "UNIQUE_VALUES"
    },
    "linkedNodeId": {
     "inputField": "Linked depot",
     "type": "UNIQUE_VALUES"
    },
    "x": {
     "inputField": "East (km)",
     "function": "MEAN"
    },
    "y": {
     "inputField": "North (km)",
     "function": "MEAN"
    },
    "colour": {
     "inputField": "Region",
     "function": "SINGLETON"
    },
    "markerSize": {
     "inputField": "Capacity",
     "function": "MEAN"
    },
    "edgeWeight": {
     "inputField": "Shipments",
     "function": "SUM"
    }
   }
  },
  "width": 900,
  "height": 560,
  "wait": 5000,
  "actions": [
   {
    "eval": "(function(){window.__c0={};window.__fcg.model.nodes.forEach(function(n){window.__c0[n.colour]=document.querySelectorAll('.nodes circle')[n.index].getAttribute('fill')});return Object.keys(window.__c0).length===5})()",
    "expectTruthy": true
   },
   {
    "hoverEval": "(function(){var n=window.__fcg.model.nodes.filter(function(n){return n.id==='Penley Hub'})[0];return [n.x,n.y]})()"
   },
   {
    "eval": "(function(){var shown=Array.from(document.querySelectorAll('.edges path')).filter(function(p){return p.getAttribute('display')!=='none'}).length;return shown>10&&shown<209})()",
    "expectTruthy": true
   },
   {
    "eval": "(function(){var n=window.__fcg.model.nodes.filter(function(n){return n.id==='Penley Hub'})[0];var t=document.querySelectorAll('.nodes circle title')[n.index].textContent;return t.indexOf('Penley Hub')===0&&t.indexOf('Region: North')>0&&t.indexOf('Capacity: ')>0&&/Links: \\d+/.test(t)})()",
    "expectTruthy": true
   },
   {
    "clickEval": "(function(){var n=window.__fcg.model.nodes.filter(function(n){return n.id==='Penley Hub'})[0];return [n.x,n.y]})()"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "(function(){var f=omniscope.view.context().viewSelection.filter;return f.inputField==='Depot'&&f.operator==='='&&f.value==='Penley Hub'&&document.querySelectorAll('.nodes circle.selected').length===1})()",
    "expectTruthy": true
   },
   {
    "screenshot": "selected"
   },
   {
    "clickEval": "(function(){var n=window.__fcg.model.nodes.filter(function(n){return n.id==='Penley Hub'})[0];return [n.x,n.y]})()"
   },
   {
    "expectSelection": false
   },
   {
    "clickEval": "(function(){var n=window.__fcg.model.nodes.filter(function(n){return n.id==='Stanmouth'})[0];return [n.x,n.y]})()"
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     890,
     550
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "North"
    },
    "waitAfter": 4000
   },
   {
    "eval": "(function(){var ok=true;window.__fcg.model.nodes.forEach(function(n){if(window.__c0[n.colour]!==document.querySelectorAll('.nodes circle')[n.index].getAttribute('fill'))ok=false});return ok&&window.__fcg.model.nodes.length===20&&document.querySelectorAll('.key text').length===1})()",
    "expectTruthy": true
   },
   {
    "screenshot": "filtered"
   },
   {
    "update": {
     "nodeId": {
      "inputField": "Depot",
      "type": "UNIQUE_VALUES"
     },
     "linkedNodeId": {
      "inputField": "Linked depot",
      "type": "UNIQUE_VALUES"
     },
     "x": {
      "inputField": "East (km)",
      "function": "MEAN"
     },
     "y": {
      "inputField": "North (km)",
      "function": "MEAN"
     },
     "colour": {
      "inputField": "Region",
      "function": "SINGLETON"
     },
     "markerSize": {
      "inputField": "Capacity",
      "function": "MEAN"
     },
     "edgeWeight": {
      "inputField": "Shipments",
      "function": "SUM"
     },
     "maxEdges": 10
    },
    "waitAfter": 4000
   },
   {
    "eval": "document.querySelectorAll('.edges path').length===10 && /heaviest/.test(document.getElementById('status').textContent)",
    "expectTruthy": true
   }
  ]
 },
