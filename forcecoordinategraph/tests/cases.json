[
 {
  "name": "showcase",
  "showcase": true,
  "data": "sample-data/routes.csv",
  "options": {
   "items": {
    "nodeId": {
     "inputField": "Depot",
     "type": "UNIQUE_VALUES"
    },
    "linkedNodeId": {
     "inputField": "Linked depot",
     "type": "UNIQUE_VALUES"
    },
    "x": {
     "inputField": "East (km)",
     "function": "MEAN"
    },
    "y": {
     "inputField": "North (km)",
     "function": "MEAN"
    },
    "colour": {
     "inputField": "Region",
     "function": "SINGLETON"
    },
    "markerSize": {
     "inputField": "Capacity",
     "function": "MEAN"
    },
    "edgeWeight": {
     "inputField": "Shipments",
     "function": "SUM"
    }
   }
  },
  "width": 900,
  "height": 560,
  "showcaseHeight": 560,
  "wait": 5000,
  "caption": "Live: 100 depots of an invented parcel carrier, placed by their map coordinates, sized by capacity and coloured by region. Routes are bundled, and thicker for more shipments. Hover a depot to see its routes; click it to select it.",
  "expect": {
   "selector": ".nodes circle",
   "min": 100,
   "max": 100
  },
  "actions": [
   {
    "eval": "window.__fcg.bundled && document.querySelectorAll('.edges path').length===209 && document.querySelectorAll('.key text').length===5 && document.querySelector('.edges path').getAttribute('d').split(/[CL]/).length>5",
    "expectTruthy": true
   }
  ]
 },
