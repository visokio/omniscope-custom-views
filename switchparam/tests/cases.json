 {
  "name": "filter",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "paramName": "Region",
    "split": {
     "inputField": "Region",
     "type": "UNIQUE_VALUES"
    }
   }
  },
  "width": 260,
  "height": 170,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Switch+Param/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Year",
     "type": "NUMBER",
     "value": 2024
    }
   ],
   "blocks": [
    "Report",
    "Filter orders"
   ]
  },
  "actions": [
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "West"
    }
   },
   {
    "eval": "document.querySelectorAll('.choice').length === 1",
    "expectTruthy": true
   },
   {
    "eval": "/Current value: North/.test(document.getElementById('message').textContent)",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "GET",
     "url": "Orders%20demo.iox/w/param/Region",
     "count": 2
    }
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/updateparams",
     "count": 0
    }
   }
  ]
 },
