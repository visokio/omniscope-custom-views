 {
  "name": "large",
  "generate": "tests/large.js",
  "options": {
   "items": {
    "paramName": "Region",
    "split": {
     "inputField": "Customer",
     "type": "UNIQUE_VALUES"
    }
   }
  },
  "width": 260,
  "height": 300,
  "wait": 1500,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Switch+Param/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Year",
     "type": "NUMBER",
     "value": 2024
    }
   ],
   "blocks": [
    "Report",
    "Filter orders"
   ]
  },
  "actions": [
   {
    "eval": "document.querySelectorAll('.choice').length === 100 && /Showing 100 of 3000 values/.test(document.body.innerText)",
    "expectTruthy": true
   },
   {
    "update": {
     "paramName": "Region",
     "split": {
      "inputField": "Customer",
      "type": "UNIQUE_VALUES"
     },
     "selectionLimit": 25
    }
   },
   {
    "eval": "document.querySelectorAll('.choice').length === 25",
    "expectTruthy": true
   }
  ]
 }
