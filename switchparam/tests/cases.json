[
 {
  "name": "showcase",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "paramName": "Region",
    "split": {
     "inputField": "Region",
     "type": "UNIQUE_VALUES"
    }
   }
  },
  "width": 260,
  "height": 170,
  "wait": 800,
  "showcase": true,
  "showcaseHeight": 170,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Switch+Param/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Year",
     "type": "NUMBER",
     "value": 2024
    }
   ],
   "blocks": [
    "Report",
    "Filter orders"
   ]
  },
  "caption": "Live: pick a region. The view sets the project parameter Region; here the Workflow REST API is simulated.",
  "expect": {
   "selector": ".choice",
   "min": 4,
   "max": 4,
   "text": "Region"
  },
  "actions": [
   {
    "expectRequest": {
     "method": "GET",
     "url": "Orders%20demo.iox/w/param/Region",
     "count": 1
    }
   },
   {
    "eval": "document.querySelector('input[value=\"North\"]').checked",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/updateparams",
     "count": 0
    }
   },
   {
    "click": "input[value=\"South\"]"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/updateparams",
     "body": {
      "updates": [
       {
        "name": "Region",
        "value": "South"
       }
      ]
     },
     "count": 1
    }
   },
   {
    "eval": "document.querySelector('input[value=\"South\"]').checked && !document.querySelector('input[value=\"North\"]').checked",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 0
    }
   },
   {
    "eval": "document.getElementById('status').textContent === 'Region set to South'",
    "expectTruthy": true
   },
   {
    "eval": "window.parent.__omniEvents.every(function (e) { return e.type !== 'whitespaceClick'; })",
    "expectTruthy": true
   },
   {
    "screenshot": "south"
   }
  ]
 },
