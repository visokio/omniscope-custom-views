 {
  "name": "update-fails",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "paramName": "Region",
    "split": {
     "inputField": "Region",
     "type": "UNIQUE_VALUES"
    }
   }
  },
  "width": 260,
  "height": 170,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Switch+Param/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Year",
     "type": "NUMBER",
     "value": 2024
    }
   ],
   "blocks": [
    "Report",
    "Filter orders"
   ],
   "respond": {
    "POST w/updateparams": {
     "status": 400,
     "body": {
      "status": "FAIL",
      "errorType": "INVALID_VALUE",
      "errorMessage": "Value not allowed"
     }
    }
   }
  },
  "actions": [
   {
    "click": "input[value=\"East\"]"
   },
   {
    "wait": 600
   },
   {
    "eval": "document.getElementById('status').textContent === 'Value not allowed'",
    "expectTruthy": true
   },
   {
    "eval": "document.querySelector('input[value=\"North\"]').checked",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 0
    }
   }
  ]
 },
