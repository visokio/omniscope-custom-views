 {
  "name": "click-point",
  "data": "sample-data/customers.csv",
  "options": {
   "items": {
    "point": {
     "inputField": "Customer ID",
     "type": "UNIQUE_VALUES"
    },
    "x": {
     "inputField": "Recency (days)",
     "function": "MEAN"
    },
    "y": {
     "inputField": "Orders per year",
     "function": "MEAN"
    },
    "z": {
     "inputField": "Annual spend (GBP)",
     "function": "MEAN"
    },
    "colour": null,
    "size": null,
    "theme": "LIGHT",
    "autoRotate": false,
    "showAxes": true,
    "pointScale": 1,
    "colourValue": {
     "inputField": "Lifetime value (GBP)",
     "function": "MEAN"
    }
   }
  },
  "width": 700,
  "height": 500,
  "wait": 4000,
  "actions": [
   {
    "clickEval": "(function(){var s=window.__scatter3d;var best=null;s.points.forEach(function(p){var q=p.pos.clone().project(s.camera);if(!best||q.z<best.z)best=q;});var c=s.renderer.domElement.getBoundingClientRect();return [(best.x+1)/2*c.width,(1-best.y)/2*c.height];})()"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "after-click"
   },
   {
    "hoverEval": "(function(){var s=window.__scatter3d;var p=s.points[5].pos.clone().project(s.camera);var c=s.renderer.domElement.getBoundingClientRect();return [(p.x+1)/2*c.width,(1-p.y)/2*c.height];})()"
   },
   {
    "eval": "document.getElementById('tooltip').style.display",
    "expectTruthy": true
   },
   {
    "screenshot": "tooltip"
   }
  ],
  "expect": {
   "notBlank": true
  }
 },
