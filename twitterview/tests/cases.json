 {
  "name": "small",
  "data": "sample-data/posts.csv",
  "types": {
   "Post ID": "TEXT"
  },
  "routes": {
   "https://platform.x.com/widgets.js": "tests/stub-widgets.js"
  },
  "options": {
   "items": {
    "atweetID": {
     "inputField": "Post URL",
     "function": "MIN"
    }
   }
  },
  "width": 180,
  "height": 140,
  "wait": 1200,
  "actions": [
   {
    "eval": "document.body.innerText.indexOf('Too narrow for a post')>=0 && !window.__tw",
    "expectTruthy": true
   },
   {
    "resize": [
     520,
     400
    ]
   },
   {
    "eval": "document.querySelectorAll('.stub-post').length===1",
    "expectTruthy": true
   }
  ]
 },
