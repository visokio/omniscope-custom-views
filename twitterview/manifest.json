{
  "name": "Twitter View",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "twitter",
    "tweet",
    "x",
    "post",
    "social media",
    "embed"
  ],
  "sandbox": false,
  "autoPane": true,
  "autoQuery": true,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "atweetID": {
        "displayName": "Post ID or URL",
        "documentation": "The field with each post's ID or URL (https://x.com/<account>/status/<id>). Keep IDs in a Text field: as numbers they lose digits. With the Singleton function a post shows when the filter or selection leaves one post; Min or Max always shows one.",
        "type": "MEASURE",
        "mandatory": true
      },
      "darkMode": {
        "displayName": "Dark mode",
        "type": "TOGGLE",
        "documentation": "Light text on a dark background, for the post and the view."
      },
      "hideConversation": {
        "displayName": "Hide conversation",
        "type": "TOGGLE",
        "documentation": "Show only the post itself, without the post it replies to."
      },
      "hideMedia": {
        "displayName": "Hide photos and link previews",
        "type": "TOGGLE",
        "documentation": "Show the post's text only: no photos, videos or link preview cards."
      },
      "paneX": {
        "displayName": "Pane X",
        "type": "GROUPING",
        "list": true,
        "documentation": "Optional: one post per value of this field, side by side."
      },
      "paneY": {
        "displayName": "Pane Y",
        "type": "GROUPING",
        "list": true,
        "documentation": "Optional: one post per value of this field, one above the other."
      }
    },
    "structure": {
      "toolbar": [
        "atweetID"
      ],
      "x": [
        "paneX"
      ],
      "y": [
        "paneY"
      ]
    }
  },
  "defaultOptions": {
    "items": {},
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "showGridLines": true,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "xHeaderStyle": {},
      "yHeaderStyle": {},
      "tileHeaderStyle": {},
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 250,
    "minHeight": 150
  }
}
