  }
 },
 {
  "name": "interact",
  "data": "sample-data/deliveries.csv",
  "options": {
   "items": {
    "value": "Hours to deliver",
    "bins": 40,
    "scale": "SHARE",
    "clip": true
   }
  },
  "width": 1000,
  "height": 500,
  "wait": 1500,
  "actions": [
   {
    "eval": "Math.abs(window.__dist.model.all.med-42.3)<1e-9 && Math.abs(window.__dist.model.all.mean-45.44075)<1e-6 && window.__dist.model.all.skew>0.5",
    "expectTruthy": true
   },
   {
    "hover": "rect.bar",
    "nth": 8
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "rect.bar",
    "nth": 8
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     5,
     495
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Carrier",
     "operator": "=",
     "value": "Carrier C"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__dist.model.all.n<3000",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     420
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
