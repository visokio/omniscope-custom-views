[
 {
  "name": "showcase",
  "showcase": true,
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "measure": {
     "inputField": "Revenue (GBP)",
     "function": "SUM"
    },
    "dimensions": [
     "Region",
     "Channel",
     "Category",
     "Customer type",
     "Carrier",
     "Warehouse"
    ],
    "maxBars": 8,
    "sortOrder": "DESCENDING",
    "autoSplits": true,
    "showPercent": true
   }
  },
  "width": 1040,
  "height": 520,
  "wait": 1500,
  "showcaseHeight": 520,
  "caption": "Live: 12,000 illustrative orders. Press + on any bar to split it by another field, or let the view pick the split with the highest value. Click a bar to select those orders.",
  "actions": [
   {
    "eval": "window.__decomp.expand(0,undefined,'Region')"
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__decomp.expand(1,'London','Channel')"
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__decomp.expand(2,'Online','Category')"
   },
   {
    "wait": 1200
   },
   {
    "eval": "document.querySelectorAll('.col').length===4",
    "expectTruthy": true
   }
  ],
  "expect": {
   "text": "Electronics"
  }
 },
 {
  "name": "root-cause",
  "showcase": true,
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "measure": {
     "inputField": "Delivery days",
     "function": "MEAN"
    },
    "dimensions": [
     "Region",
     "Channel",
     "Category",
     "Customer type",
     "Carrier",
     "Warehouse"
    ],
    "maxBars": 8,
    "sortOrder": "DESCENDING",
    "autoSplits": true,
    "showPercent": true
   }
  },
  "width": 1040,
  "height": 420,
  "wait": 1500,
  "showcaseHeight": 420,
  "caption": "Live: average delivery days. Two automatic 'highest value' splits find the slow warehouse and then the carrier responsible.",
  "actions": [
   {
    "eval": "window.__decomp.auto(0,undefined,true)"
   },
   {
    "wait": 1500
   },
   {
    "eval": "(function(){var L=window.__decomp.levels[1];return L.dim+':'+L.rows[0].value})()"
   },
   {
    "eval": "window.__decomp.auto(1,window.__decomp.levels[1].rows[0].value,true)"
   },
   {
    "wait": 1500
   },
   {
    "eval": "(function(){var a=window.__decomp.levels.map(function(l){return l.dim}).join('>');return a})()"
   },
   {
    "eval": "window.__decomp.levels.length===3 && ['Warehouse','Carrier'].indexOf(window.__decomp.levels[1].dim)>=0",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "measure": {
     "inputField": "Revenue (GBP)",
     "function": "SUM"
    },
    "dimensions": [
     "Region",
     "Channel",
     "Category",
     "Customer type",
     "Carrier",
     "Warehouse"
    ],
    "maxBars": 8,
    "sortOrder": "DESCENDING",
    "autoSplits": true,
    "showPercent": true
   }
  },
  "width": 1000,
  "height": 520,
  "wait": 1500,
  "actions": [
   {
    "click": ".root .plus"
   },
   {
    "click": "#menu .mi[data-dim='Region']",
    "waitAfter": 1200
   },
   {
    "click": ".col:nth-of-type(2) .node[data-k='1']",
    "waitAfter": 800
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "selected"
   },
   {
    "hover": ".col:nth-of-type(2) .node[data-k='0']"
   },
   {
    "click": ".col:nth-of-type(2) .node[data-k='0'] .plus"
   },
   {
    "click": "#menu .mi[data-dim='Category']",
    "waitAfter": 1200
   },
   {
    "eval": "window.__decomp.levels.length===3",
    "expectTruthy": true
   },
   {
    "click": ".col:nth-of-type(2) .node[data-k='2']",
    "waitAfter": 1500
   },
   {
    "eval": "window.__decomp.levels[2].rows.length>0",
    "expectTruthy": true
   },
   {
    "clickAt": [
     990,
     510
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Channel",
     "operator": "=",
     "value": "Store"
    }
   },
   {
    "eval": "/filtered/.test(document.body.innerText)",
    "expectTruthy": true
   },
   {
    "resize": [
     600,
     400
    ]
   },
   {
    "screenshot": "resized"
   }
  ],
  "expect": {
   "text": "Region"
  }
 },
