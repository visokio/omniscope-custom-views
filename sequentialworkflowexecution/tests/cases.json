[
 {
  "name": "showcase",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders, Clean, Summarise",
    "buttonText": "Run the three steps"
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "showcase": true,
  "showcaseHeight": 150,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Sequential+Workflow+Execution/",
  "workflow": {
   "states": [
    "RUNNING",
    "COMPLETED"
   ]
  },
  "caption": "Live: press the button. The blocks run one after another, each starting when the one before has finished (simulated Workflow REST API).",
  "expect": {
   "text": "Run the three steps"
  },
  "actions": [
   {
    "click": "#run"
   },
   {
    "wait": 700
   },
   {
    "eval": "/^Block 1 of 3, Load orders/.test(document.getElementById('status').textContent)",
    "expectTruthy": true
   },
   {
    "screenshot": "running"
   },
   {
    "wait": 4800
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Load orders"
      ],
      "refreshFromSource": true,
      "cancelExisting": false
     },
     "count": 1
    }
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Clean"
      ]
     },
     "count": 1
    }
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Summarise"
      ]
     },
     "count": 1
    }
   },
   {
    "eval": "var r = window.__omniMock.workflow.requests.filter(function (q) { return q.method === 'POST'; }).map(function (q) { return q.body.blocks[0]; }); r.join('|') === 'Load orders|Clean|Summarise'",
    "expectTruthy": true
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished all 3 blocks') === 0",
    "expectTruthy": true
   },
   {
    "eval": "window.parent.__omniEvents.every(function (e) { return e.type !== 'whitespaceClick'; })",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "reload-mid-sequence",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders, Clean, Summarise"
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Sequential+Workflow+Execution/",
  "workflow": {
   "states": [
    "RUNNING",
    "COMPLETED"
   ]
  },
  "actions": [
   {
    "click": "#run",
    "waitAfter": 200
   },
   {
    "reload": true
   },
   {
    "eval": "/^Block 1 of 3, Load orders/.test(document.getElementById('status').textContent)",
    "expectTruthy": true
   },
   {
    "wait": 1500
   },
   {
    "reload": true
   },
   {
    "wait": 4500
   },
   {
    "eval": "window.__omniMock.workflow.requests.filter(function (q) { return q.method === 'POST'; }).map(function (q) { return q.body.blocks[0]; }).join('|') === 'Load orders|Clean|Summarise'",
    "expectTruthy": true
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished all 3 blocks') === 0 && !document.getElementById('run').disabled",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "stops-on-failure",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders, Clean, Summarise"
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Sequential+Workflow+Execution/",
  "workflow": {
   "states": [
    "RUNNING",
    "COMPLETED"
   ],
   "failBlocks": [
    "Clean"
   ]
  },
  "actions": [
   {
    "click": "#run"
   },
   {
    "wait": 4500
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Summarise"
      ]
     },
     "count": 0
    }
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Clean"
      ]
     },
     "count": 1
    }
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Stopped at block 2 of 3, Clean: Failed') === 0",
    "expectTruthy": true
   },
   {
    "clickAt": [
     300,
     140
    ]
   },
   {
    "expectSelection": false
   }
  ]
 },
 {
  "name": "unknown-block",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders, Tidy"
   }
  },
  "width": 360,
  "height": 160,
