   }
  ]
 },
 {
  "name": "filter",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders, Clean, Summarise"
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Sequential+Workflow+Execution/",
  "actions": [
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "West"
    }
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 0
    }
   },
   {
    "eval": "!document.getElementById('run').disabled",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "small",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders, Clean, Summarise"
   }
  },
  "width": 120,
  "height": 60,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Sequential+Workflow+Execution/",
  "workflow": {
   "states": [
    "RUNNING",
    "COMPLETED"
   ]
  },
  "actions": [
   {
    "eval": "document.getElementById('run').getBoundingClientRect().right <= window.innerWidth + 1",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "wait": 5500
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished all 3') === 0",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "empty",
  "fields": [
   {
    "name": "Region",
    "type": "TEXT"
   }
  ],
  "options": {
   "items": {
    "block": "Load orders, Clean, Summarise"
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Sequential+Workflow+Execution/",
  "expect": {
   "selector": "#run",
   "min": 1
  }
 },
 {
  "name": "unconfigured",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {}
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Sequential+Workflow+Execution/",
  "actions": [
   {
    "eval": "document.getElementById('run').disabled && document.getElementById('status').textContent.indexOf('Enter the blocks to execute') === 0",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 0
    }
   },
   {
    "update": {
     "block": "Report"
    }
   },
   {
    "eval": "!document.getElementById('run').disabled && document.getElementById('status').textContent === ''",
    "expectTruthy": true
   }
  ]
 },
 {
