  "actions": [
   {
    "eval": "(function(){var c=window.__idx.model.cells.find(function(x){return x.r.name==='Gaming'&&x.c.name==='18-24'});return Math.abs(c.idx-209.72325789263158)<1e-6 && Math.abs(c.adj-25.91533594324439)<1e-6 && c.sig})()",
    "expectTruthy": true
   },
   {
    "hover": "g.cell",
    "nth": 9
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "g.cell",
    "nth": 9
   },
   {
    "expectSelection": true
   },
   {
    "eval": "omniscope.view.context().viewSelection.filter.type==='AND'",
    "expectTruthy": true
   },
   {
    "click": "text.hd",
    "nth": 0
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     5,
     455
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "North"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__idx.model.T<9000",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     420
    ]
   },
   {
    "screenshot": "narrow"
   }
