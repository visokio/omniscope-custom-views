{
  "name": "Concentration",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "readme": "README.md",
  "tags": [
    "custom",
    "lorenz curve",
    "gini",
    "concentration",
    "pareto",
    "hhi",
    "inequality",
    "dependency",
    "visokio-agents"
  ],
  "sandbox": false,
  "autoPane": false,
  "autoQuery": true,
  "dataLimit": 200000,
  "supportsSelection": true,
  "options": {
    "items": {
      "item": {
        "displayName": "Items",
        "type": "GROUPING",
        "mandatory": true,
        "validGroupingTypes": [
          "UNIQUE_VALUES"
        ],
        "detail": "What the total is spread over, e.g. Customer, Product, Supplier"
      },
      "value": {
        "displayName": "Measure",
        "type": "MEASURE",
        "mandatory": true,
        "validMeasureResultTypes": [
          "NUMBER"
        ],
        "detail": "e.g. sum of Revenue (negative values are left out)"
      },
      "compare": {
        "displayName": "Compare by",
        "type": "GROUPING",
        "validGroupingTypes": [
          "UNIQUE_VALUES"
        ],
        "detail": "Optional: one curve per group, e.g. Segment (up to 8)"
      }
    },
    "structure": {
      "toolbar": [
        "item",
        "value",
        "compare"
      ],
      "x": [],
      "y": []
    },
    "optionGroups": [
      {
        "displayName": "Concentration",
        "rows": [
          {
            "cells": [
              {
                "option": "item",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "value",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "compare",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {},
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 300,
      "paneHeight": 200,
      "gridLineThickness": 1,
      "headerStyle": {},
      "tileHeaderAlignment": "CENTER",
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 300,
    "minHeight": 250
  }
}
