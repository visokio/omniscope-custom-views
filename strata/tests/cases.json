 {
  "name": "interact",
  "data": "sample-data/tickets.csv",
  "options": {
   "items": {
    "layer": "Ticket",
    "start": "Start",
    "end": "End",
    "label": "Title",
    "colour": "Team",
    "emphasis": "Emphasis",
    "momentAt": "Moment time",
    "moment": "Moment",
    "order": "Longest-lived on top",
    "labels": "At the end",
    "intro": "None",
    "workday": true,
    "standup": "09:30",
    "emphasisNames": "Being worked, Waiting on requester, Queued"
   }
  },
  "width": 1000,
  "height": 600,
  "wait": 3000,
  "actions": [
   {
    "hoverEval": "(function(){var r=document.querySelector('.scroller').getBoundingClientRect();var ps=document.querySelectorAll('.chart .grab');for(var i=0;i<ps.length;i++){var p=ps[i],L=p.getTotalLength();for(var k=1;k<40;k++){var q=p.getPointAtLength(L*k/40),m=p.getScreenCTM(),x=m.a*q.x+m.c*q.y+m.e,y=m.b*q.x+m.d*q.y+m.f;if(x>r.left+20&&x<r.right-200&&y>r.top+5&&y<r.bottom-30){var h=document.elementFromPoint(x,y);if(h===p){window.__pickIndex=+p.dataset.index;return [x,y];}}}}return null})()"
   },
   {
    "eval": "(function(){var t=document.querySelector('.tip'),lit=document.querySelectorAll('.chart .line.lit'),ix={};lit.forEach(function(l){ix[l.dataset.index]=1});return t.style.display==='block'&&/^T-1\\d{3} /.test(t.textContent)&&t.textContent.indexOf('open:')>0&&/(Being worked|Waiting on requester|Queued): /.test(t.textContent)&&lit.length>0&&Object.keys(ix).length===1})()",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "clickEval": "(function(){var r=document.querySelector('.scroller').getBoundingClientRect();var ps=document.querySelectorAll('.chart .grab');for(var i=0;i<ps.length;i++){var p=ps[i],L=p.getTotalLength();for(var k=1;k<40;k++){var q=p.getPointAtLength(L*k/40),m=p.getScreenCTM(),x=m.a*q.x+m.c*q.y+m.e,y=m.b*q.x+m.d*q.y+m.f;if(x>r.left+20&&x<r.right-200&&y>r.top+5&&y<r.bottom-30){var h=document.elementFromPoint(x,y);if(h===p){window.__pickIndex=+p.dataset.index;return [x,y];}}}}return null})()"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "(function(){var s=omniscope.view.context().viewSelection,f=s.filter||s;f=f.filters?f.filters[0]:f;return f.inputField==='Ticket'&&f.operator==='='&&/^T-1\\d{3}$/.test(f.value)})()",
    "expectTruthy": true
   },
   {
    "clickAt": [
     500,
     590
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Team",
     "operator": "=",
     "value": "Network"
    }
   },
   {
    "eval": "(function(){var ix={};document.querySelectorAll('.chart .line').forEach(function(l){ix[l.dataset.index]=1});var n=Object.keys(ix).length;return n>0&&n<=38})()",
    "expectTruthy": true
   },
   {
    "screenshot": "filtered"
   }
  ]
 },
