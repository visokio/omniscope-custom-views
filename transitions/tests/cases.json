  }
 },
 {
  "name": "twoyears",
  "showcase": true,
  "data": "sample-data/customer_tiers.csv",
  "options": {
   "items": {
    "item": "Customer",
    "period": "Year",
    "state": "Tier",
    "order": "Platinum, Gold, Silver, Bronze, Lapsed",
    "from": "2024",
    "to": "2026"
   }
  },
  "width": 1000,
  "height": 480,
  "wait": 1500,
  "showcaseHeight": 480,
  "caption": "Live: the same customers over two years, 2024 to 2026: more of them have moved.",
  "expect": {
   "selector": "g.cell",
   "min": 25
  }
 },
 {
  "name": "interact",
  "data": "sample-data/customer_tiers.csv",
  "options": {
   "items": {
    "item": "Customer",
    "period": "Year",
    "state": "Tier",
    "order": "Platinum, Gold, Silver, Bronze, Lapsed"
   }
  },
  "width": 1000,
  "height": 520,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var M=window.__trans.model;return M.A==='2025' && M.B==='2026' && M.stay===3741 && M.up===684 && M.cells['Gold\\u0001Silver'].items.length===100})()",
    "expectTruthy": true
   },
   {
    "hover": "g.cell",
    "nth": 7
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "g.cell",
    "nth": 7
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     5,
     515
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "East"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__trans.model.both<1800",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     440
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
 {
  "name": "unordered",
  "data": "sample-data/customer_tiers.csv",
  "options": {
   "items": {
    "item": "Customer",
    "period": "Year",
    "state": "Tier"
   }
  },
  "width": 900,
  "height": 460,
  "wait": 1500,
  "actions": [
   {
    "eval": "window.__trans.model.ordered===false && window.__trans.model.states[0]==='Bronze'",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "newgone",
  "data": "sample-data/customer_tiers.csv",
  "filter": {
   "type": "OR",
   "filters": [
    {
     "type": "AND",
     "filters": [
      {
       "type": "FIELD_VALUE",
       "inputField": "Year",
       "operator": "=",
       "value": 2025
      },
      {
       "type": "FIELD_VALUE",
       "inputField": "Region",
       "operator": "=",
       "value": "North"
      }
     ]
    },
    {
     "type": "AND",
     "filters": [
      {
       "type": "FIELD_VALUE",
       "inputField": "Year",
       "operator": "=",
       "value": 2026
      },
      {
       "type": "FIELD_VALUE",
       "inputField": "Region",
       "operator": "!=",
       "value": "West"
      }
     ]
    }
   ]
  },
  "options": {
   "items": {
    "item": "Customer",
    "period": "Year",
    "state": "Tier",
    "order": "Platinum, Gold, Silver, Bronze, Lapsed"
   }
  },
  "width": 900,
  "height": 460,
  "wait": 1500,
  "actions": [
   {
    "eval": "window.__trans.model.fresh>1000 && window.__trans.model.gone===0",
    "expectTruthy": true
   }
  ]
 },
