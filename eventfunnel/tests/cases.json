[
 {
  "name": "showcase",
  "showcase": true,
  "data": "sample-data/events.csv",
  "options": {
   "items": {
    "user": "Visitor",
    "event": "Event",
    "time": "Time",
    "steps": "Visited site, Viewed product, Added to basket, Started checkout, Purchased"
   }
  },
  "width": 1060,
  "height": 500,
  "wait": 1500,
  "showcaseHeight": 500,
  "caption": "Live: an illustrative web shop event log of 8,000 visitors. Hover a bar for counts and times; click a bar or a pale drop-off cap to select those visitors.",
  "expect": {
   "selector": "rect.bar",
   "min": 5
  }
 },
 {
  "name": "channels",
  "showcase": true,
  "data": "sample-data/events.csv",
  "options": {
   "items": {
    "user": "Visitor",
    "event": "Event",
    "time": "Time",
    "steps": "Visited site, Viewed product, Added to basket, Started checkout, Purchased",
    "group": "Channel"
   }
  },
  "width": 1060,
  "height": 500,
  "wait": 1500,
  "showcaseHeight": 500,
  "caption": "Live: the same funnel compared by acquisition channel.",
  "expect": {
   "selector": "rect.bar",
   "min": 15
  }
 },
 {
  "name": "interact",
  "data": "sample-data/events.csv",
  "options": {
   "items": {
    "user": "Visitor",
    "event": "Event",
    "time": "Time",
    "steps": "Visited site, Viewed product, Added to basket, Started checkout, Purchased"
   }
  },
  "width": 1000,
  "height": 500,
  "wait": 1500,
  "actions": [
   {
    "eval": "JSON.stringify(window.__fun.model.all.reach)==='[8000,5909,2515,1423,748]' && window.__fun.model.worst===2",
    "expectTruthy": true
   },
   {
    "hover": "rect.bar",
    "nth": 2
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "rect.bar",
    "nth": 4
   },
   {
    "expectSelection": true
   },
   {
    "eval": "omniscope.view.context().viewSelection.filter.filters.length===748",
    "expectTruthy": true
   },
   {
    "click": "rect.drop",
    "nth": 3
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     10,
     490
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Device",
     "operator": "=",
     "value": "Desktop"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__fun.model.all.reach[0]<4000",
    "expectTruthy": true
   },
   {
    "resize": [
     560,
     420
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
 {
