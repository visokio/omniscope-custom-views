 {
  "name": "interact",
  "data": "sample-data/payments.csv",
  "options": {
   "items": {
    "value": "Amount",
    "group": "Approver",
    "digits": "FIRST",
    "minValue": 10,
    "negatives": true,
    "minGroup": 100,
    "maxRows": 500000
   }
  },
  "width": 1000,
  "height": 540,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){function ev(f,v){if(f.type==='AND')return f.filters.every(function(x){return ev(x,v)});if(f.type==='OR')return f.filters.some(function(x){return ev(x,v)});var t=f.value;return f.operator==='>='?v>=t:f.operator==='<'?v<t:f.operator==='>'?v>t:f.operator==='<='?v<=t:false};var M=window.__ben.model,r4=M.all.rows[3];var f=window.__ben.digitFilter(4),cnt=M.vals.filter(function(v){return ev(f,v)}).length;return M.all.N===20000 && Math.abs(M.all.mad-0.00913484021301681)<1e-9 && r4.n===2592 && cnt===r4.n && M.groups[0].name==='Approver E'})()",
    "expectTruthy": true
   },
   {
    "hover": "rect.bar",
    "nth": 3
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "eval": "window.__ben.focusGroup('Approver E')"
   },
   {
    "expectSelection": true
   },
   {
    "wait": 500
   },
   {
    "screenshot": "focus"
   },
   {
    "click": "rect.bar",
    "nth": 3
   },
   {
    "expectSelection": true
   },
   {
    "eval": "window.__ben.sel.digit===4 && window.__ben.sel.group==='Approver E'",
    "expectTruthy": true
   },
   {
    "clickAt": [
     20,
     530
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Cost centre",
     "operator": "=",
     "value": "IT"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__ben.model.all.N<6000",
    "expectTruthy": true
   },
   {
    "resize": [
     600,
     440
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
