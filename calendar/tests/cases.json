[
 {
  "name": "showcase",
  "showcase": true,
  "data": "sample-data/visits.csv",
  "options": {
   "items": {
    "date": "Date",
    "value": {
     "inputField": "Visitors",
     "function": "SUM"
    }
   }
  },
  "width": 760,
  "height": 320,
  "showcaseHeight": 320,
  "wait": 1500,
  "caption": "Live: daily visitors to an invented museum in 2024 and 2025. Mondays are grey: the museum is closed.",
  "expect": {
   "selector": ".day",
   "min": 731,
   "max": 731,
   "text": "Visitors (sum)"
  },
  "actions": [
   {
    "eval": "Object.keys(__calendar.days).length === 620 && document.querySelectorAll('.day:not(.nodata)').length === 620",
    "expectTruthy": true
   },
   {
    "eval": "Object.values(__calendar.days).reduce((a, d) => a + d.value, 0) === 525528",
    "expectTruthy": true
   },
   {
    "eval": "document.querySelector('.day[data-day=\"2024-01-01\"]').classList.contains('nodata') && !document.querySelector('.day[data-day=\"2024-01-02\"]').classList.contains('nodata')",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/visits.csv",
  "options": {
   "items": {
    "date": "Date",
    "value": {
     "inputField": "Visitors",
     "function": "SUM"
    }
   }
  },
  "width": 760,
  "height": 320,
  "wait": 1500,
  "actions": [
   {
    "hover": ".day[data-day='2025-07-05']"
   },
   {
    "eval": "document.getElementById('tooltip').textContent.indexOf('Sat 5 Jul 2025') === 0",
    "expectTruthy": true
   },
   {
    "click": ".day[data-day='2025-07-05']"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "JSON.stringify(omniscope.view.context().viewSelection.filter.filters.map(f => [f.operator, f.value])) === JSON.stringify([['>=', '2025-07-05'], ['<', '2025-07-06']])",
    "expectTruthy": true
   },
   {
    "eval": "document.querySelectorAll('.day.faded').length === 730",
    "expectTruthy": true
   },
   {
    "screenshot": "selected"
   },
   {
    "click": ".day[data-day='2025-07-05']"
   },
   {
    "expectSelection": false
   },
   {
    "click": ".day[data-day='2025-03-12']"
   },
   {
    "expectSelection": true
   },
   {
    "click": ".day[data-day='2025-03-10']"
   },
   {
    "expectSelection": false
   },
   {
    "eval": "document.querySelectorAll('.day.faded').length === 0",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "filter",
  "data": "sample-data/visits.csv",
  "options": {
   "items": {
    "date": "Date",
    "value": {
     "function": "RECORD_COUNT"
    }
   }
  },
  "width": 760,
  "height": 320,
  "wait": 1500,
  "actions": [
   {
    "eval": "__calendar.hi === 3",
    "expectTruthy": true
   },
   {
    "filter": {
     "type": "AND",
     "filters": [
      {
       "type": "FIELD_VALUE",
       "inputField": "Gallery",
       "operator": "=",
       "value": "Maritime"
      },
      {
       "type": "FIELD_VALUE",
       "inputField": "Date",
       "operator": ">=",
       "value": "2025-01-01"
      }
     ]
    }
   },
   {
    "eval": "__calendar.hi === 1 && __calendar.years.join() === '2025,2025' && document.querySelectorAll('.day').length === 365",
    "expectTruthy": true
   },
   {
    "screenshot": "one-year"
   }
  ]
 },
 {
