 {
  "name": "interact",
  "data": "sample-data/payments.csv",
  "options": {
   "items": {
    "source": {
     "inputField": "Payer",
     "type": "UNIQUE_VALUES"
    },
    "target": {
     "inputField": "Payee",
     "type": "UNIQUE_VALUES"
    },
    "weight": {
     "inputField": "Amount (GBP)",
     "function": "SUM"
    },
    "sizeBy": "BETWEENNESS",
    "colourBy": "COMMUNITY",
    "directed": true,
    "labels": "TOP",
    "labelCount": 12,
    "minWeight": 1500,
    "showPanel": true
   }
  },
  "width": 1000,
  "height": 640,
  "wait": 5000,
  "actions": [
   {
    "eval": "window.__network.model.communities.length",
    "expectTruthy": true
   },
   {
    "click": "#panel .row.comm",
    "nth": 0
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "community"
   },
   {
    "clickEval": "(function(){var S=window.__network,t=S.transform,d=S.model.ranked[0];return [t.x+t.k*d.x,t.y+t.k*d.y];})()"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "focus"
   },
   {
    "eval": "window.__network.focus!==null",
    "expectTruthy": true
   },
   {
    "clickEval": "[5,630]"
   },
   {
    "expectSelection": false
   },
   {
    "eval": "(function(){var p=window.__network.showPath('ACC-0347','ACC-CASHOUT');return p&&p.length;})()",
    "expectTruthy": true
   },
   {
    "screenshot": "path"
   },
   {
    "resize": [
     640,
     420
    ]
   },
   {
    "screenshot": "resized"
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Channel",
     "operator": "=",
     "value": "Faster Payment"
    }
   },
   {
    "eval": "window.__network.nodes.length>0",
    "expectTruthy": true
   }
  ],
  "expect": {
   "notBlank": true
  }
 },
