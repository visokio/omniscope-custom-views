   { "eval": "(() => { const p = document.getElementById('pivot'); return p.scrollWidth > p.clientWidth && p.scrollHeight > p.clientHeight; })()", "expectTruthy": true },
   { "screenshot": "200x120" }
  ]
 },
 {
  "name": "empty",
  "fields": [ { "name": "Region", "type": "TEXT" }, { "name": "Units", "type": "NUMBER" } ],
  "options": { "items": { "measures": { "inputField": "Units", "function": "SUM" }, "paneY": [ { "inputField": "Region", "type": "UNIQUE_VALUES" } ] } },
  "width": 400, "height": 300, "wait": 1000,
  "expect": { "text": "No data to show" }
 },
 {
  "name": "unconfigured",
  "data": "sample-data/orders.csv",
  "options": { "items": { "measures": { "function": "RECORD_COUNT" } } },
  "width": 400, "height": 300, "wait": 1000,
  "expect": { "text": "Choose one or more Rows" }
 },
 {
  "name": "large",
  "generate": "tests/large.js",
  "options": { "items": {
    "measures": { "inputField": "Units", "function": "SUM" },
    "paneY": [ { "inputField": "Day", "type": "HISTOGRAM", "dateUnit": "DAY", "histogramInterval": 1 } ],
    "paneX": [ { "inputField": "Store", "type": "UNIQUE_VALUES" } ] } },
  "width": 640, "height": 460, "wait": 3000,
  "actions": [
   { "eval": "document.querySelectorAll('tbody tr').length === 500 && [...document.querySelectorAll('tbody tr.last td:not(.dim)')].reduce((a, td) => a + +td.textContent.replace(/,/g, ''), 0) === 1010000", "expectTruthy": true }
  ]
 },
 {
