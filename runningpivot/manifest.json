{
  "name": "Running Pivot View",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "pivot",
    "running",
    "totals",
    "running total"
  ],
  "sandbox": false,
  "autoPane": false,
  "autoQuery": false,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "measures": {
        "displayName": "Measure",
        "type": "MEASURE",
        "mandatory": true,
        "detail": "The value added up down each column, for example the sum of Sales. Use a measure that adds up: a sum or a record count"
      },
      "paneX": {
        "displayName": "Columns",
        "type": "GROUPING",
        "list": true,
        "detail": "Optional: one column of running totals per value, for example Region. Several fields nest"
      },
      "paneY": {
        "displayName": "Rows",
        "type": "GROUPING",
        "list": true,
        "mandatory": true,
        "detail": "The order of the running total, for example Order date by month. Several fields nest; the total runs through all of them"
      }
    },
    "structure": {
      "toolbar": [
        "measures"
      ],
      "x": [
        "paneX"
      ],
      "y": [
        "paneY"
      ]
    },
    "optionGroups": [
      {
        "displayName": "Pivot",
        "rows": [
          {
            "cells": [
              {
                "option": "measures",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "paneY",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "paneX",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {},
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "showGridLines": true,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "showPaneXHeader": true,
      "showPaneYHeader": true,
      "showTileHeader": true,
      "xHeaderStyle": {},
      "yHeaderStyle": {},
      "tileHeaderStyle": {},
      "xHeaderLines": 1,
      "tileHeaderLines": 1,
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
