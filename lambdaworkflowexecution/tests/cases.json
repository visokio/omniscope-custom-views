[
 {
  "name": "showcase",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Export summary",
    "paramNames": "Region, Minimum sales"
   }
  },
  "width": 420,
  "height": 190,
  "wait": 800,
  "showcase": true,
  "showcaseHeight": 190,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Lambda+Workflow+Execution/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Minimum sales",
     "type": "NUMBER",
     "value": 100
    },
    {
     "name": "Report title",
     "type": "TEXT",
     "value": "Orders"
    }
   ]
  },
  "caption": "Live: change the values and press Execute. Each press would run in a new copy of the project; here the Workflow REST API is simulated.",
  "expect": {
   "selector": ".param",
   "min": 2,
   "max": 2
  },
  "actions": [
   {
    "eval": "(function () { document.getElementById('param-Region').value = 'South'; document.getElementById('param-Minimum_sales').value = '250'; return true; })()",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/lambdaexecute",
     "body": {
      "blocks": [
       "Export summary"
      ],
      "deleteExecutionOnFinish": false,
      "params": {
       "updates": [
        {
         "name": "Region",
         "value": "South"
        },
        {
         "name": "Minimum sales",
         "value": 250
        }
       ]
      }
     },
     "count": 1
    }
   },
   {
    "wait": 3200
   },
   {
    "expectRequest": {
     "method": "GET",
     "url": "Orders%20demo.iox/w/job/JOB_1/state"
    }
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished at') === 0 && document.querySelector('#status a').textContent === 'Open the copy of the project'",
    "expectTruthy": true
   },
   {
    "eval": "document.querySelector('#status a').href.indexOf('https://omniscope.example.com/Demos/') === 0",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 0
    }
   },
   {
    "eval": "window.parent.__omniEvents.every(function (e) { return e.type !== 'whitespaceClick'; })",
    "expectTruthy": true
   },
   {
    "screenshot": "finished"
   }
  ]
 },
 {
  "name": "variables",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Export summary",
    "setParametersUsingVariables": true
   }
  },
  "width": 420,
  "height": 220,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Lambda+Workflow+Execution/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Minimum sales",
     "type": "NUMBER",
     "value": 100
    },
    {
     "name": "Report title",
     "type": "TEXT",
     "value": "Orders"
    }
   ]
  },
  "variables": {
   "Region": "East",
   "Report title": "East orders"
  },
  "actions": [
   {
    "eval": "document.getElementById('param-Region').readOnly && document.getElementById('param-Region').value === 'East'",
    "expectTruthy": true
   },
   {
    "eval": "/No report variable/.test(document.querySelector('.note').textContent)",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/lambdaexecute",
     "body": {
      "params": {
       "updates": [
        {
         "name": "Region",
         "value": "East"
        },
        {
         "name": "Report title",
         "value": "East orders"
        }
       ]
      }
     },
     "count": 1
    }
   }
  ]
 },
 {
  "name": "refresh-report",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Export summary",
    "paramNames": "Region",
    "deleteExecutionOnFinish": true,
    "refreshThisReportOnFinish": true
   }
  },
  "width": 420,
  "height": 170,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Lambda+Workflow+Execution/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Minimum sales",
     "type": "NUMBER",
     "value": 100
    },
    {
     "name": "Report title",
     "type": "TEXT",
     "value": "Orders"
    }
   ]
  },
  "actions": [
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/lambdaexecute",
     "body": {
      "deleteExecutionOnFinish": true
     },
     "count": 1
    }
   },
   {
    "wait": 3400
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Report"
      ],
      "refreshFromSource": true,
      "cancelExisting": false
     },
     "count": 1
    }
   },
   {
    "eval": "/copy of the project was deleted/.test(document.getElementById('status').textContent) && !document.querySelector('#status a')",
    "expectTruthy": true
   },
   {
    "clickAt": [
     400,
     160
    ]
   },
   {
    "expectSelection": false
   }
  ]
 },
 {
  "name": "reload-mid-job",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Export summary",
    "paramNames": "Region",
    "deleteExecutionOnFinish": true,
    "refreshThisReportOnFinish": true
   }
  },
  "width": 420,
  "height": 170,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Lambda+Workflow+Execution/",
  "workflow": {
   "params": [
    {
     "name": "Region",
     "type": "TEXT",
     "value": "North"
    },
    {
     "name": "Minimum sales",
     "type": "NUMBER",
     "value": 100
    },
    {
     "name": "Report title",
     "type": "TEXT",
     "value": "Orders"
    }
   ]
  },
  "actions": [
   {
    "click": "#run",
    "waitAfter": 200
   },
   {
    "reload": true
   },
   {
    "wait": 3400
   },
   {
    "eval": "/^Finished at .*copy of the project was deleted/.test(document.getElementById('status').textContent)",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/lambdaexecute",
     "count": 1
    }
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Report"
      ]
     },
     "count": 1
    }
   },
   {
    "reload": true
   },
   {
    "eval": "/^Finished at/.test(document.getElementById('status').textContent)",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 1
    }
   }
  ]
 },
