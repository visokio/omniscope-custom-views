 {
  "name": "interact",
  "data": "sample-data/survey_responses.csv",
  "options": {
   "items": {
    "answer": "Answer",
    "question": "Question",
    "scale": "AUTO",
    "sort": "NET"
   }
  },
  "width": 1000,
  "height": 420,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var M=window.__lik.model,R=M.rows.find(function(r){return r.q==='Workload in my team is manageable'});return M.sc.kind==='known' && M.sc.order[0]==='Strongly disagree' && M.sc.order[4]==='Strongly agree' && R.n===618 && Math.abs(R.net-(-0.3284789644012945))<1e-9 && M.qs[M.qs.length-1]==='Workload in my team is manageable' && M.excluded>100})()",
    "expectTruthy": true
   },
   {
    "hover": "rect.seg",
    "nth": 7
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "rect.seg",
    "nth": 7
   },
   {
    "expectSelection": true
   },
   {
    "eval": "omniscope.view.context().viewSelection.filter.type==='AND'",
    "expectTruthy": true
   },
   {
    "click": "text.qlab",
    "nth": 2
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     5,
     410
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Department",
     "operator": "=",
     "value": "Finance"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__lik.model.total<700",
    "expectTruthy": true
   },
   {
    "resize": [
     520,
     420
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
