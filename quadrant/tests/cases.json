 {
  "name": "interact",
  "data": "sample-data/products.csv",
  "options": {
   "items": {
    "item": {
     "inputField": "Product line",
     "type": "UNIQUE_VALUES"
    },
    "x": {
     "inputField": "Relative market share",
     "function": "MEAN"
    },
    "y": {
     "inputField": "Market growth %",
     "function": "MEAN"
    },
    "size": {
     "inputField": "Revenue (m)",
     "function": "SUM"
    },
    "colour": {
     "inputField": "Business unit",
     "type": "UNIQUE_VALUES"
    },
    "xSplit": "TARGET",
    "xTarget": 1,
    "ySplit": "TARGET",
    "yTarget": 5,
    "preset": "BCG",
    "logX": true,
    "labels": true
   }
  },
  "width": 1000,
  "height": 540,
  "wait": 1200,
  "actions": [
   {
    "eval": "window.__quad.model.pts.filter(function(p){return p.q===0}).length===8 && window.__quad.model.cx===1",
    "expectTruthy": true
   },
   {
    "hover": "circle.dot",
    "nth": 3
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "circle.dot",
    "nth": 3
   },
   {
    "expectSelection": true
   },
   {
    "eval": "window.__quad.selectQuad(0)"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "omniscope.view.context().viewSelection.filter.filters.length===8",
    "expectTruthy": true
   },
   {
    "clickAt": [
     500,
     8
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Business unit",
     "operator": "=",
     "value": "Digital"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__quad.model.pts.length<20",
    "expectTruthy": true
   },
   {
    "resize": [
     520,
     420
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
