 {
  "name": "interact",
  "data": "sample-data/contacts.csv",
  "options": {
   "items": {
    "time": "Received",
    "show": "AVERAGE",
    "utcOffset": 0
   }
  },
  "width": 1000,
  "height": 420,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var M=window.__week.model;var mon=M.cells.filter(function(c){return c.d===0});return Math.abs(M.cells[10].v-43.57692307692308)<1e-6 && d3.sum(mon,function(c){return c.sum})===8170 && M.total===35360})()",
    "expectTruthy": true
   },
   {
    "hover": "rect.cell",
    "nth": 34
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "eval": "window.__week.selectDay(0)"
   },
   {
    "expectSelection": true
   },
   {
    "eval": "(function(){var f=omniscope.view.context().viewSelection.filter;return f.type==='OR' && f.filters.length>=26 && f.filters.length<400})()",
    "expectTruthy": true
   },
   {
    "click": "rect.cell",
    "nth": 34
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "cell"
   },
   {
    "clickAt": [
     5,
     415
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Channel",
     "operator": "=",
     "value": "Email"
    }
   },
   {
    "wait": 800
   },
   {
    "eval": "window.__week.model.total<6000",
    "expectTruthy": true
   },
   {
    "resize": [
     520,
     360
    ]
   },
   {
    "screenshot": "narrow"
   }
  ]
 },
 {
