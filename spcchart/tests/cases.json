 {
  "name": "interact",
  "data": "sample-data/attendances.csv",
  "options": {
   "items": {
    "time": {
     "inputField": "Arrival date",
     "type": "HISTOGRAM",
     "dateUnit": "WEEK",
     "histogramInterval": 1
    },
    "value": {
     "inputField": "Wait (minutes)",
     "function": "MEAN"
    },
    "direction": "LOWER",
    "target": 210,
    "baseline": 0,
    "runLength": 7,
    "trendLength": 6,
    "showMR": true,
    "showSigma": false
   }
  },
  "width": 1000,
  "height": 520,
  "wait": 2000,
  "actions": [
   {
    "eval": "window.__spc.points.filter(function(p){return p.cause==='concern'}).length>0 && window.__spc.points.filter(function(p){return p.cause==='improve'}).length>0",
    "expectTruthy": true
   },
   {
    "eval": "window.__spc.points[30].flags.join('|')"
   },
   {
    "hover": "rect[fill=transparent]"
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "eval": "window.__spc.selectRange(70,80,false)"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "selected"
   },
   {
    "clickAt": [
     520,
     8
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Department",
     "operator": "=",
     "value": "Main ED"
    }
   },
   {
    "eval": "window.__spc.points.length>90",
    "expectTruthy": true
   },
   {
    "resize": [
     520,
     300
    ]
   },
   {
    "screenshot": "small"
   }
  ]
 },
