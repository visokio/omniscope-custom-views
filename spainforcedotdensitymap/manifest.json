{
  "name": "Spain Force Dot Density Map",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "custom",
    "map",
    "dot",
    "density",
    "force",
    "jitter",
    "spain"
  ],
  "sandbox": false,
  "autoPane": true,
  "autoQuery": true,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "lat": {
        "displayName": "Dot latitude",
        "type": "MEASURE",
        "mandatory": true,
        "validFieldTypes": [
          "NUMBER"
        ],
        "detail": "Latitude of each dot in decimal degrees, for example the mean of a Latitude field"
      },
      "lon": {
        "displayName": "Dot longitude",
        "type": "MEASURE",
        "mandatory": true,
        "validFieldTypes": [
          "NUMBER"
        ],
        "detail": "Longitude of each dot in decimal degrees (west is negative), for example the mean of a Longitude field"
      },
      "paneX": {
        "displayName": "Pane X",
        "type": "GROUPING",
        "list": true
      },
      "paneY": {
        "displayName": "Pane Y",
        "type": "GROUPING",
        "list": true
      },
      "split": {
        "displayName": "Split",
        "type": "GROUPING",
        "mandatory": true,
        "detail": "One dot per value of this grouping, for example per site or per customer. Click a dot to select its value"
      },
      "colour": {
        "displayName": "Colour",
        "type": "MEASURE",
        "detail": "Colours the dots by category. Use a text field with the Singleton function (for example Region), which gives each dot its one value"
      },
      "dotsize": {
        "displayName": "Dot radius (pixels)",
        "type": "NUMBER",
        "detail": "Radius of each dot in pixels. If empty, the dots get smaller as their number grows (1.2 to 4 pixels)"
      },
      "tooltiptitle": {
        "displayName": "Tooltip label",
        "detail": "Label for the Tooltip value in a dot's tooltip. If empty, the measure's name is used",
        "type": "TEXT"
      },
      "tooltipvalue": {
        "displayName": "Tooltip value",
        "type": "MEASURE",
        "detail": "A figure shown in a dot's tooltip, for example the sum of Sales"
      }
    },
    "structure": {
      "toolbar": [],
      "x": [
        "lon",
        "paneX"
      ],
      "y": [
        "lat",
        "paneY"
      ]
    },
    "optionGroups": [
      {
        "displayName": "Chart",
        "rows": [
          {
            "cells": [
              {
                "option": "split",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "lat",
                "usePrefixTitle": false
              },
              {
                "option": "lon",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Dots",
        "rows": [
          {
            "cells": [
              {
                "option": "colour",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "dotsize",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "title": "Tooltip",
            "cells": [
              {
                "option": "tooltipvalue",
                "usePrefixTitle": false
              },
              {
                "option": "tooltiptitle",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Pane/tile",
        "rows": [
          {
            "cells": [
              {
                "option": "paneX",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "paneY",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {},
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 100,
      "paneHeight": 100,
      "gridLineThickness": 1,
      "headerStyle": {},
      "tileHeaderAlignment": "CENTER",
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50,
    "maxCells": 20
  }
}
