[
 {
  "name": "showcase",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders, Report",
    "buttonText": "Refresh the orders"
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "showcase": true,
  "showcaseHeight": 150,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Workflow+Execution/",
  "workflow": {
   "blocks": [
    "Load orders",
    "Report"
   ]
  },
  "caption": "Live: press the button. Here the Workflow REST API is simulated: the job is queued, runs and finishes.",
  "expect": {
   "text": "Refresh the orders"
  },
  "actions": [
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Load orders",
       "Report"
      ],
      "refreshFromSource": true,
      "cancelExisting": false
     },
     "count": 1
    }
   },
   {
    "eval": "document.getElementById('run').disabled",
    "expectTruthy": true
   },
   {
    "wait": 3200
   },
   {
    "expectRequest": {
     "method": "GET",
     "url": "Orders%20demo.iox/w/job/JOB_1/state"
    }
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished at') === 0 && !document.getElementById('run').disabled",
    "expectTruthy": true
   },
   {
    "eval": "window.parent.__omniEvents.every(function (e) { return e.type !== 'whitespaceClick'; })",
    "expectTruthy": true
   },
   {
    "screenshot": "finished"
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders",
    "refreshFromSource": false
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Workflow+Execution/",
  "workflow": {
   "blocks": [
    "Load orders",
    "Report"
   ]
  },
  "actions": [
   {
    "click": "#run"
   },
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Load orders"
      ],
      "refreshFromSource": false
     },
     "count": 1
    }
   },
   {
    "wait": 3200
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished') === 0",
    "expectTruthy": true
   },
   {
    "clickAt": [
     300,
     140
    ]
   },
   {
    "expectSelection": false
   },
   {
    "update": {
     "block": "Load orders",
     "showJobState": false
    }
   },
   {
    "eval": "document.getElementById('status').textContent === ''",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "wait": 3200
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 2
    }
   },
   {
    "eval": "document.getElementById('status').textContent === ''",
    "expectTruthy": true
   }
  ]
 },
