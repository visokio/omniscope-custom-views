 {
  "name": "reload-mid-job",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Load orders, Report"
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Workflow+Execution/",
  "workflow": {
   "blocks": [
    "Load orders",
    "Report"
   ]
  },
  "actions": [
   {
    "click": "#run",
    "waitAfter": 200
   },
   {
    "reload": true
   },
   {
    "eval": "document.getElementById('run').disabled",
    "expectTruthy": true
   },
   {
    "wait": 3200
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished at') === 0 && !document.getElementById('run').disabled",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 1
    }
   },
   {
    "reload": true
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished at') === 0",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "count": 1
    }
   }
  ]
 },
 {
