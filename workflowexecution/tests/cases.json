 {
  "name": "already-running",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Report"
   }
  },
  "width": 360,
  "height": 160,
  "wait": 800,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Workflow+Execution/",
  "workflow": {
   "respond": {
    "POST w/execute": {
     "status": 409,
     "body": {
      "errorType": "WORKFLOW_ALREADY_RUNNING",
      "errorMessage": "There is another execution running or queued for this file."
     }
    }
   }
  },
  "actions": [
   {
    "click": "#run"
   },
   {
    "eval": "/another execution/.test(document.getElementById('status').textContent)",
    "expectTruthy": true
   }
  ]
 },
