{
  "name": "Upload and Execute",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "custom",
    "lambda",
    "upload",
    "parameter",
    "param",
    "workflow",
    "job",
    "execute",
    "execution",
    "block",
    "api"
  ],
  "sandbox": false,
  "autoPane": false,
  "autoQuery": false,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "block": {
        "displayName": "Blocks to execute",
        "type": "TEXT",
        "detail": "Names of the workflow blocks to execute, separated by commas, e.g. Load orders, Report. Leave empty to execute the whole workflow."
      },
      "buttonText": {
        "displayName": "Button text",
        "type": "TEXT",
        "detail": "Text on the button. If empty: Upload and execute"
      },
      "deleteExecutionOnFinish": {
        "displayName": "Delete the copy when finished",
        "type": "TOGGLE",
        "detail": "Delete the copy of the project, and its execution data, when the execution ends. Off: the copy is kept."
      },
      "paramName": {
        "displayName": "File parameter",
        "type": "TEXT",
        "detail": "Name of the project parameter that receives the uploaded file; link it to the File block's path. Default: uploadedFile."
      },
      "refreshThisReportOnFinish": {
        "displayName": "Refresh this report when finished",
        "type": "TOGGLE",
        "detail": "When the execution has finished, execute this report's block (from source) so the report shows what the execution wrote."
      },
      "showJobState": {
        "displayName": "Show job state",
        "type": "TOGGLE",
        "detail": "Show the execution's progress (queued, running, finished) under the button. Errors are always shown."
      }
    },
    "structure": {
      "toolbar": [
        "block",
        "buttonText",
        "paramName",
        "deleteExecutionOnFinish",
        "refreshThisReportOnFinish",
        "showJobState"
      ],
      "x": [],
      "y": []
    }
  },
  "defaultOptions": {
    "items": {
      "deleteExecutionOnFinish": true,
      "paramName": "uploadedFile",
      "refreshThisReportOnFinish": true,
      "showJobState": true
    },
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "showGridLines": true,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "xHeaderStyle": {},
      "yHeaderStyle": {},
      "tileHeaderStyle": {},
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
