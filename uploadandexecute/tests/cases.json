[
 {
  "name": "showcase",
  "data": "sample-data/orders.csv",
  "options": {
   "items": {
    "block": "Append upload"
   }
  },
  "width": 420,
  "height": 170,
  "wait": 800,
  "showcase": true,
  "showcaseHeight": 170,
  "baseUrl": "https://omniscope.example.com/Demos/Orders%20demo.iox/er/Report/customview/Upload+and+Execute/",
  "workflow": {
   "params": [
    {
     "name": "uploadedFile",
     "type": "TEXT",
     "value": ""
    }
   ]
  },
  "caption": "Live: choose any file and press the button. Nothing is uploaded here: the Workflow REST API is simulated in your browser.",
  "actions": [
   {
    "eval": "document.getElementById('run').disabled && /Choose a file/.test(document.body.innerText)",
    "expectTruthy": true
   },
   {
    "eval": "(function () { var dt = new DataTransfer(); dt.items.add(new File(['Order ID,Region\\nO0241,North\\n'], 'new-orders.csv', { type: 'text/csv' })); var i = document.getElementById('file'); i.files = dt.files; i.dispatchEvent(new Event('change')); return true; })()",
    "expectTruthy": true
   },
   {
    "eval": "!document.getElementById('run').disabled",
    "expectTruthy": true
   },
   {
    "eval": "/new-orders.csv, \\d+ bytes/.test(document.getElementById('message').textContent)",
    "expectTruthy": true
   },
   {
    "click": "#run"
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/uploadandexecute",
     "body": {
      "uploadedFile_formdata_key": {
       "file": "new-orders.csv"
      },
      "execution": {
       "blocks": [
        "Append upload"
       ],
       "deleteExecutionOnFinish": true,
       "params": {
        "updates": [
         {
          "name": "uploadedFile",
          "formDataKey": "uploadedFile_formdata_key"
         }
        ]
       }
      }
     },
     "count": 1
    }
   },
   {
    "wait": 3400
   },
   {
    "eval": "document.getElementById('status').textContent.indexOf('Finished at') === 0",
    "expectTruthy": true
   },
   {
    "expectRequest": {
     "method": "POST",
     "url": "Orders%20demo.iox/w/execute",
     "body": {
      "blocks": [
       "Report"
      ],
      "refreshFromSource": true
     },
     "count": 1
    }
   },
   {
    "eval": "window.parent.__omniEvents.every(function (e) { return e.type !== 'whitespaceClick'; })",
    "expectTruthy": true
   },
   {
    "screenshot": "finished"
   }
  ]
 },
