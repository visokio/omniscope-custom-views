  "wait": 3000,
  "actions": [
   {
    "update": {
     "source": "From",
     "target": "To",
     "date": {
      "inputField": "Time",
      "type": "UNIQUE_VALUES"
     },
     "size": {
      "inputField": "Amount (£)",
      "function": "SUM"
     },
     "link": "Transfer ID",
     "centreNodeId": "Group treasury",
     "animationDuration": 1,
     "txLabels": true
    }
   },
   {
    "eval": "__orbital.play.flying.length===0 && __orbital.play.done",
    "expectTruthy": true
   },
   {
    "eval": "(function(){var c=__omniMock.config,ds=JSON.parse(JSON.stringify(c.dataset));ds.rows.push(['TR-9001','2026-03-02T18:30:00.000Z','France','Group treasury',1000],['TR-9002','2026-03-02T18:31:00.000Z','Group treasury','Spain',2000]);__omniMock.update({options:c.options,dataset:ds});return true})()",
    "waitAfter": 1500
   },
   {
    "wait": 300
   },
   {
    "eval": "__orbital.play.flying.length===2 && __orbital.model.txs.length===242",
    "expectTruthy": true
   },
   {
    "update": {
     "source": "From",
     "target": "To",
     "date": {
      "inputField": "Time",
      "type": "UNIQUE_VALUES"
     },
     "size": {
      "inputField": "Amount (£)",
      "function": "SUM"
     },
     "link": "Transfer ID",
     "centreNodeId": "Group treasury",
     "animationDuration": 1,
     "txLabels": true,
     "animationRestartOnData": true
    }
   },
   {
    "eval": "__orbital.play.flying.length===242",
    "expectTruthy": true
   }
  ]
 },
