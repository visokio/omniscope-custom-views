[
 {
  "name": "showcase",
  "showcase": true,
  "data": "sample-data/transfers.csv",
  "options": {
   "items": {
    "source": "From",
    "target": "To",
    "date": {
     "inputField": "Time",
     "type": "UNIQUE_VALUES"
    },
    "size": {
     "inputField": "Amount (£)",
     "function": "SUM"
    },
    "link": "Transfer ID",
    "centreNodeId": "Group treasury",
    "animationDuration": 12
   }
  },
  "width": 900,
  "height": 560,
  "showcaseHeight": 560,
  "wait": 5000,
  "caption": "Live: 240 invented transfers over one working day between a group treasury and eight subsidiaries. Press Replay to watch again; hover a node for its totals, click it to select its transfers.",
  "expect": {
   "selector": "g.node",
   "min": 9,
   "max": 9,
   "notBlank": true
  },
  "actions": [
   {
    "eval": "__orbital.model.txs.length===240 && __orbital.model.centre.id==='Group treasury' && __orbital.play.flying.length===240",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "hourly",
  "showcase": true,
  "data": "sample-data/transfers.csv",
  "options": {
   "items": {
    "source": "From",
    "target": "To",
    "date": {
     "inputField": "Time",
     "type": "HISTOGRAM",
     "dateUnit": "HOUR",
     "histogramInterval": 1
    },
    "size": {
     "inputField": "Amount (£)",
     "function": "SUM"
    },
    "link": "Transfer ID",
    "centreNodeId": "Group treasury",
    "animationDuration": 8,
    "txLabels": true
   }
  },
  "width": 900,
  "height": 560,
  "showcaseHeight": 560,
  "wait": 3000,
  "caption": "Live: the same day with Transaction time grouped per hour, so transfers between the same two companies in each hour fly as one, and Show transaction details on.",
  "expect": {
   "selector": "g.node",
   "min": 9,
   "max": 9
  },
  "actions": [
   {
    "eval": "__orbital.model.txs.length===151 && __orbital.model.histogram && document.getElementById('info').style.display==='block'",
    "expectTruthy": true
   },
   {
    "eval": "__orbital.finish(), /151 combined transactions/.test(document.getElementById('info').textContent) && /8\\.88M/.test(document.getElementById('info').textContent)",
    "expectTruthy": true
   }
  ]
 },
 {
  "name": "interact",
  "data": "sample-data/transfers.csv",
  "options": {
   "items": {
    "source": "From",
    "target": "To",
    "date": {
     "inputField": "Time",
     "type": "UNIQUE_VALUES"
    },
    "size": {
     "inputField": "Amount (£)",
     "function": "SUM"
    },
    "link": "Transfer ID",
    "centreNodeId": "Group treasury",
    "animationDuration": 1
   }
  },
  "width": 900,
  "height": 560,
  "wait": 3500,
  "actions": [
   {
    "eval": "(function(){var t=__orbital.model.byId.get('Group treasury');window.__c0={};__orbital.model.nodes.forEach(function(n){__c0[n.id]=n.colour});return __orbital.play.done && Math.abs(t.shownReceived-6466078.84)<0.01 && Math.abs(t.shownSent-1711904.51)<0.01})()",
    "expectTruthy": true
   },
   {
    "eval": "[].some.call(document.querySelectorAll('.label .figures'),function(e){return e.textContent==='In 6.47M  Out 1.71M'})",
    "expectTruthy": true
   },
   {
    "eval": "/Sent: 1.2M \\(25 transactions\\)/.test(document.querySelectorAll('g.node title')[3].textContent)",
    "expectTruthy": true
   },
   {
    "click": "g.node",
    "nth": 3
   },
   {
    "expectSelection": true
   },
   {
    "eval": "(function(){var f=omniscope.view.context().viewSelection.filter;return f.type==='OR'&&f.filters[0].inputField==='From'&&f.filters[0].value==='Germany'&&f.filters[1].inputField==='To'&&document.querySelectorAll('g.node.selected').length===1})()",
    "expectTruthy": true
   },
   {
    "screenshot": "selected"
   },
   {
    "click": "g.node.selected"
   },
   {
    "expectSelection": false
   },
   {
    "click": "g.node",
    "nth": 5
   },
   {
    "expectSelection": true
   },
   {
    "clickAt": [
     30,
     200
    ]
   },
   {
    "expectSelection": false
   },
   {
    "eval": "document.querySelectorAll('g.node.selected').length===0 && document.querySelectorAll('g.node.faded').length===0",
    "expectTruthy": true
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "From",
     "operator": "=",
     "value": "Germany"
    }
   },
   {
    "eval": "(function(){var m=__orbital.model,ok=m.txs.length===25&&__orbital.play.flying.length===0&&Math.abs(m.byId.get('Germany').shownSent-1195861.36)<0.01;m.nodes.forEach(function(n){if(n.colour!==__c0[n.id])ok=false});return ok})()",
    "expectTruthy": true
   },
   {
    "screenshot": "filtered"
   },
   {
    "click": "#replay"
   },
   {
    "eval": "__orbital.play.flying.length===25 && !__orbital.play.done",
    "expectTruthy": true
   },
   {
    "expectSelection": false
   }
  ]
 },
 {
