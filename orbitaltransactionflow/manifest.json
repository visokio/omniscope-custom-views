{
  "name": "Orbital Transaction Flow",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "thumbnail": "thumbnail.png",
  "tags": [
    "custom",
    "transaction",
    "flow",
    "circle",
    "gooey",
    "orbit"
  ],
  "sandbox": false,
  "autoPane": true,
  "autoQuery": false,
  "supportsSelection": true,
  "options": {
    "items": {
      "animationDuration": {
        "displayName": "Duration (seconds)",
        "detail": "How long one replay of all the transactions takes, from 1 to 100 seconds. Default 10.",
        "type": "NUMBER",
        "mandatory": true,
        "isDecimal": false,
        "minValue": 1,
        "maxValue": 100
      },
      "animationRestartOnData": {
        "displayName": "Replay on every refresh",
        "detail": "Off (default): when the data is refreshed, only transactions later than the last one shown fly in, and a change of filter or settings shows the new totals at once. On: every refresh, filter or settings change replays all the transactions.",
        "type": "TOGGLE"
      },
      "txLabels": {
        "displayName": "Show transaction details",
        "detail": "Shows the sender, receiver, time and size of each transaction in a box at the top left as it flies.",
        "type": "TOGGLE"
      },
      "centreNodeId": {
        "displayName": "Centre node",
        "detail": "The sender or receiver to place at the centre, typed exactly as it appears in the data, for example Group treasury. If empty, the busiest one (largest total sent and received) is placed at the centre.",
        "type": "TEXT"
      },
      "date": {
        "displayName": "Transaction time",
        "detail": "When each transaction happened; transactions fly in this order. Use Unique values to show every transaction, or a histogram (for example per hour) to combine transactions between the same sender and receiver in each interval into one.",
        "type": "GROUPING",
        "mandatory": true,
        "validFieldTypes": [
          "DATE"
        ]
      },
      "link": {
        "displayName": "Transaction identifier",
        "detail": "Optional field that identifies each transaction, so that two transactions with the same time, sender and receiver stay separate. Not used when Transaction time is a histogram.",
        "type": "FIELD",
        "validFieldTypes": [
          "TEXT",
          "NUMBER"
        ]
      },
      "paneX": {
        "displayName": "Pane X",
        "type": "GROUPING",
        "list": true,
        "detail": "One orbit per value, side by side"
      },
      "paneY": {
        "displayName": "Pane Y",
        "type": "GROUPING",
        "list": true,
        "detail": "One orbit per value, one above the other"
      },
      "size": {
        "displayName": "Transaction size",
        "detail": "Sizes the flying dots and adds up into each node's Sent and Received totals, for example the sum of Amount. Record count counts transactions.",
        "iconName": "visokio-option-icon:size-measure",
        "type": "MEASURE",
        "mandatory": true
      },
      "source": {
        "displayName": "Sender",
        "detail": "Field naming who sends each transaction, for example From account",
        "type": "FIELD",
        "mandatory": true,
        "validFieldTypes": [
          "TEXT",
          "NUMBER"
        ]
      },
      "target": {
        "displayName": "Receiver",
        "detail": "Field naming who receives each transaction, for example To account",
        "type": "FIELD",
        "mandatory": true,
        "validFieldTypes": [
          "TEXT",
          "NUMBER"
        ]
      }
    },
    "structure": {
      "toolbar": [
        "source",
        "target",
        "date",
        "size"
      ],
      "x": [
        "paneX"
      ],
      "y": [
        "paneY"
      ]
    },
    "optionGroups": [
      {
        "displayName": "Transactions",
        "rows": [
          {
            "cells": [
              {
                "option": "source",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "target",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "date",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "size",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "link",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Layout",
        "rows": [
          {
            "cells": [
              {
                "option": "centreNodeId",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Animation",
        "rows": [
          {
            "cells": [
              {
                "option": "animationDuration",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "animationRestartOnData",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "txLabels",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Pane/tile",
        "rows": [
          {
            "cells": [
              {
                "option": "paneX",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "paneY",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {
      "animationDuration": 10
    },
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 200,
      "paneHeight": 200,
      "gridLineThickness": 1,
      "gridLineColour": "rgba(229,229,229,1)",
      "headerStyle": {
        "size": 12,
        "colour": "#333333",
        "backgroundColour": "#FFFFFF"
      },
      "tileHeaderAlignment": "CENTER",
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50
  }
}
