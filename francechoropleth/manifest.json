{
  "name": "France Choropleth",
  "frameworkVersion": "v1",
  "icon": "icon.svg",
  "tags": [
    "custom",
    "map",
    "france"
  ],
  "thumbnail": "thumbnail.png",
  "sandbox": false,
  "autoPane": true,
  "autoQuery": true,
  "dataLimit": 10000,
  "supportsSelection": true,
  "options": {
    "items": {
      "measures": {
        "displayName": "Colour",
        "type": "MEASURE",
        "iconName": "visokio-option-icon:colour-measure",
        "mandatory": true,
        "detail": "The value that colours each department, for example the sum of Sales. Lighter is lower, darker is higher"
      },
      "paneX": {
        "displayName": "Pane X",
        "type": "GROUPING",
        "list": true,
        "detail": "Optional: one map per value, side by side"
      },
      "paneY": {
        "displayName": "Pane Y",
        "type": "GROUPING",
        "list": true,
        "detail": "Optional: one map per value, one above the other"
      },
      "split": {
        "displayName": "Department field",
        "type": "GROUPING",
        "detail": "A field holding French department names (Ain, Côte-d'Or) or INSEE codes (01, 2A, 974); each value colours one department"
      }
    },
    "structure": {
      "toolbar": [
        "measures",
        "split"
      ],
      "x": [
        "paneX"
      ],
      "y": [
        "paneY"
      ]
    },
    "optionGroups": [
      {
        "displayName": "Map",
        "rows": [
          {
            "cells": [
              {
                "option": "split",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "measures",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      },
      {
        "displayName": "Panes",
        "rows": [
          {
            "cells": [
              {
                "option": "paneX",
                "usePrefixTitle": false
              }
            ]
          },
          {
            "cells": [
              {
                "option": "paneY",
                "usePrefixTitle": false
              }
            ]
          }
        ]
      }
    ]
  },
  "defaultOptions": {
    "items": {},
    "pane": {
      "yAxisHeaderWidth": 75,
      "paneWidth": 100,
      "paneHeight": 100,
      "gridLineThickness": 1,
      "headerStyle": {},
      "tileHeaderAlignment": "CENTER",
      "xHeaderPlacement": "TOP",
      "yHeaderPlacement": "LEFT",
      "showColourKeyInEveryPane": false,
      "enableTouchScrolling": false
    }
  },
  "pane": {
    "minWidth": 50,
    "minHeight": 50,
    "maxCells": 20
  }
}
