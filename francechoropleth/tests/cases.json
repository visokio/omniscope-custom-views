[
 {
  "name": "showcase", "showcase": true,
  "data": "sample-data/orders.csv",
  "options": { "items": { "split": { "inputField": "Department", "type": "UNIQUE_VALUES" }, "measures": { "inputField": "Sales", "function": "SUM" } } },
  "width": 640, "height": 640, "showcaseHeight": 640, "wait": 1500,
  "caption": "Live: invented sales of 2,000 orders, summed by department. Hover a department for its value; click it to select its orders.",
  "expect": { "selector": ".dept", "min": 105, "max": 105, "text": "Sales (sum)" },
  "actions": [
   { "eval": "document.querySelectorAll('.dept.nodata').length === 0 && Object.keys(__france.model.values).length === 101", "expectTruthy": true },
   { "eval": "Math.abs(Object.values(__france.model.values).reduce((a, b) => a + b, 0) - 157894.98) < 0.01", "expectTruthy": true },
   { "eval": "document.getElementById('note').textContent === ''", "expectTruthy": true }
  ]
 },
 {
  "name": "codes", "showcase": true,
