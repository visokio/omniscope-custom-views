   { "screenshot": "bretagne" },
   { "update": { "split": { "inputField": "Region", "type": "UNIQUE_VALUES" }, "measures": { "inputField": "Sales", "function": "SUM" } } },
   { "eval": "/None of the 1 Department values/.test(document.getElementById('note').textContent)", "expectTruthy": true }
  ]
 },
