  ]
 },
 {
  "name": "interact",
  "data": "sample-data/orders.csv",
  "options": { "items": { "split": { "inputField": "Department", "type": "UNIQUE_VALUES" }, "measures": { "inputField": "Sales", "function": "SUM" } } },
  "width": 640, "height": 640, "wait": 1500,
  "actions": [
   { "hover": ".dept[data-code='33']" },
   { "eval": "document.getElementById('tooltip').textContent.indexOf('Gironde (33)') === 0", "expectTruthy": true },
   { "click": ".dept[data-code='33']" },
   { "expectSelection": true },
   { "eval": "JSON.stringify(omniscope.view.context().viewSelection.filter.filters[0]) === JSON.stringify({type: 'FIELD_VALUE', inputField: 'Department', operator: '=', value: 'Gironde'})", "expectTruthy": true },
   { "eval": "document.querySelectorAll('.dept.faded').length === 104 && document.querySelector('.dept.selected').getAttribute('data-code') === '33'", "expectTruthy": true },
   { "screenshot": "selected" },
   { "click": ".dept[data-code='33']" },
   { "expectSelection": false },
   { "click": ".dept[data-code='75']", "nth": 1 },
   { "expectSelection": true },
   { "eval": "omniscope.view.context().viewSelection.filter.filters[0].value === 'Paris'", "expectTruthy": true },
   { "clickAt": [620, 20] },
   { "expectSelection": false },
   { "eval": "document.querySelectorAll('.dept.faded').length === 0", "expectTruthy": true }
  ]
 },
 {
  "name": "filter",
  "data": "sample-data/orders.csv",
