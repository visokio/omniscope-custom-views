 {
  "name": "interact",
  "data": "sample-data/sales.csv",
  "options": {
   "items": {
    "time": {
     "inputField": "Month",
     "type": "UNIQUE_VALUES"
    },
    "item": {
     "inputField": "Product",
     "type": "UNIQUE_VALUES"
    },
    "value": {
     "inputField": "Units sold",
     "function": "SUM"
    },
    "topN": 10,
    "which": "LATEST",
    "order": "HIGH",
    "showValues": true
   }
  },
  "width": 1000,
  "height": 520,
  "wait": 1500,
  "actions": [
   {
    "eval": "(function(){var M=window.__bump.model,a=M.items.find(function(o){return o.key==='Aero Bottle'});return a&&a.last.rank===1&&M.periods.length===18})()",
    "expectTruthy": true
   },
   {
    "hover": "circle.pt",
    "nth": 5
   },
   {
    "eval": "document.getElementById('tooltip').style.display==='block'",
    "expectTruthy": true
   },
   {
    "screenshot": "hover"
   },
   {
    "click": "text.lab",
    "nth": 0
   },
   {
    "expectSelection": true
   },
   {
    "eval": "window.__bump.select({item:'Air Fryer',period:window.__bump.model.periods[10].key})"
   },
   {
    "expectSelection": true
   },
   {
    "screenshot": "selected"
   },
   {
    "clickAt": [
     500,
     515
    ]
   },
   {
    "expectSelection": false
   },
   {
    "filter": {
     "type": "FIELD_VALUE",
     "inputField": "Region",
     "operator": "=",
     "value": "Scotland"
    }
   },
   {
    "eval": "window.__bump.model.items.length>=10",
    "expectTruthy": true
   },
   {
    "resize": [
     520,
     340
    ]
   },
   {
    "screenshot": "small"
   }
  ]
 },
